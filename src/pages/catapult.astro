---
import Layout from '../layouts/Layout.astro';
import CatapultGame from '../components/CatapultGame.astro';
---

<Layout title="Neon Catapult | bigf.me" description="A procedural neon catapult game by Bunyasit Fang.">
  <main class="catapult-page">
    <div class="catapult-grid" aria-hidden="true"></div>
    <header class="catapult-header">
      <a class="back-link" href="/" aria-label="Back to bigf.me">← bigf.me</a>
      <div class="title-lockup">
        <span class="title-kicker">ARCADE / 001</span>
        <h1>NEON CATAPULT</h1>
      </div>
      <p class="title-note">Aim. Launch. Break the skyline.</p>
    </header>

    <section class="game-shell" aria-labelledby="game-heading">
      <h2 id="game-heading" class="sr-only">Neon Catapult game</h2>
      <div id="catapult-hud" class="catapult-hud" aria-live="polite">
        <div class="hud-readout"><span>LEVEL</span><strong id="level-value">01 / 03</strong></div>
        <div class="hud-readout"><span>SHOTS</span><strong id="shots-value">5</strong></div>
        <div class="hud-readout"><span>SCORE</span><strong id="score-value">0000</strong></div>
        <div class="hud-status"><span>STATUS</span><strong id="status-value">READY TO AIM</strong></div>
      </div>
      <div id="catapult-game" aria-label="3D catapult game"></div>
      <div id="fallback-panel" class="fallback-panel" hidden>
        <strong>WEBGL SIGNAL LOST</strong>
        <p>This game needs a WebGL-capable browser to render its neon arena.</p>
        <a href="/">Return to bigf.me</a>
      </div>
      <div class="game-actions">
        <p class="controls-copy"><span>DRAG</span> catapult band to aim · <span>ARROWS</span> adjust · <span>SPACE</span> launch · <span>R</span> restart</p>
        <div class="action-buttons">
          <button id="restart-button" type="button">↻ Restart</button>
          <button id="next-level-button" type="button" hidden>Next level →</button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .catapult-page { min-height: 100vh; position: relative; overflow: hidden; background: #08080c; color: #e2e8f0; font-family: var(--font-mono); isolation: isolate; }
  .catapult-grid { position: absolute; inset: 0; z-index: -1; opacity: .32; background-image: linear-gradient(rgba(0,212,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,107,157,.06) 1px, transparent 1px); background-size: 56px 56px; transform: perspective(500px) rotateX(55deg) scale(1.8) translateY(25%); transform-origin: center bottom; }
  .catapult-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; padding: 1.4rem clamp(1rem, 4vw, 4rem) .8rem; position: relative; z-index: 2; }
  .back-link { color: #5cceff; text-decoration: none; font-size: .72rem; border-bottom: 1px solid rgba(92,206,255,.45); padding-bottom: .25rem; }
  .title-lockup { text-align: center; }
  .title-kicker { color: #ff6b9d; font-size: .62rem; letter-spacing: .16em; }
  h1 { margin: .25rem 0 0; color: #e2e8f0; font-family: var(--font-display); font-size: clamp(1.35rem, 4vw, 2.8rem); letter-spacing: .08em; line-height: 1; text-shadow: 0 0 14px rgba(92,206,255,.35); }
  .title-note { margin: .1rem 0 0; color: #8993a8; font-size: .68rem; text-align: right; }
  .game-shell { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; position: relative; }
  .catapult-hud { display: grid; grid-template-columns: repeat(3, minmax(75px, 1fr)) minmax(170px, 2fr); gap: 1px; position: absolute; top: 1rem; left: 1rem; right: 1rem; z-index: 3; border: 1px solid rgba(92,206,255,.25); background: rgba(8,8,12,.84); backdrop-filter: blur(7px); }
  .hud-readout, .hud-status { padding: .65rem .8rem; border-right: 1px solid rgba(92,206,255,.16); }
  .hud-readout span, .hud-status span { display: block; color: #8993a8; font-size: .58rem; letter-spacing: .15em; }
  .hud-readout strong, .hud-status strong { display: block; margin-top: .22rem; color: #e2e8f0; font-size: .78rem; letter-spacing: .06em; }
  .hud-status strong { color: #42ff9e; }
  #catapult-game { min-height: min(72vh, 720px); height: calc(100vh - 190px); max-height: 720px; min-height: 480px; border: 1px solid rgba(92,206,255,.28); background: #08080c; box-shadow: inset 0 0 90px rgba(0,0,0,.8); touch-action: none; }
  #catapult-game canvas { display: block; width: 100%; height: 100%; }
  .fallback-panel { position: absolute; inset: 5rem 1rem 4.6rem; display: grid; place-content: center; text-align: center; background: #10101a; border: 1px solid #ff6b9d; color: #e2e8f0; padding: 2rem; }
  .fallback-panel strong { color: #ff6b9d; letter-spacing: .16em; }
  .fallback-panel p { max-width: 36ch; color: #b8c0d0; font-family: var(--font-sans); }
  .fallback-panel a { color: #5cceff; }
  .game-actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 0 1.3rem; }
  .controls-copy { margin: 0; color: #8993a8; font-size: .62rem; line-height: 1.7; }
  .controls-copy span { color: #5cceff; }
  .action-buttons { display: flex; gap: .6rem; }
  button { border: 1px solid #2a2a3f; background: #15151f; color: #ff6b9d; padding: .55rem .8rem; font: inherit; font-size: .68rem; cursor: pointer; }
  button:hover, button:focus-visible { border-color: #ff6b9d; background: #ff6b9d; color: #08080c; outline: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 620px) { .catapult-header { gap: .7rem; padding-inline: 1rem; } .title-note { display: none; } .game-shell { width: calc(100% - 1rem); } .catapult-hud { grid-template-columns: repeat(3, 1fr); } .hud-status { grid-column: 1 / -1; border-top: 1px solid rgba(92,206,255,.16); border-right: 0; } #catapult-game { min-height: 510px; height: calc(100vh - 190px); } .game-actions { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .catapult-grid { transform: none; opacity: .15; } }
</style>
