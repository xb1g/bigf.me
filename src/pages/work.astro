---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/images/profile.jpg';
import { packages, workMeta, formatThb } from '../lib/work_plans';
let bookingUrl = workMeta.bookingUrl;
try {
  const url = new URL(import.meta.env.PUBLIC_BOOKING_URL || workMeta.bookingUrl);
  if (url.protocol === 'https:') bookingUrl = url.href;
} catch { /* Keep the confirmed booking link if an override is invalid. */ }
const faqs = [
  ['Can we talk before I commit?', 'Yes. Book a 30-minute project call to discuss the problem, your budget and the right first step. There is no payment required to request a call.'],
  ['What happens after the call?', 'You receive a written scope, price, timeline and payment milestones. Work starts after we agree the scope and the kickoff payment is made.'],
  ['What do you need from me?', 'One person who can approve decisions, your existing assets and content, and time to review the demo. Delivery estimates begin once the agreed inputs are ready.'],
  ['Who owns the finished work?', 'The agreed source code and project documentation are handed over after full payment. Hosting, domains and third-party services are listed separately in your quote.'],
  ['What happens after launch?', 'Builds include a 14-day window for fixes to defects in the agreed scope. Ongoing maintenance and new features can be scoped separately.'],
  ['Can we work in Thai?', 'ได้ครับ คุยรายละเอียดและทำงานร่วมกันได้ทั้งภาษาไทยและภาษาอังกฤษ'],
];
---
<Layout title={workMeta.title} description={workMeta.description}>
  <div class="services">
    <a href="#main" class="skip-link">Skip to services</a>
    <header class="studio-nav">
      <a class="wordmark" href="/" aria-label="bigf.me home">bigf<span>.me</span><span class="nav-divider">/</span><span class="nav-label">Independent builder</span></a>
      <nav aria-label="Services navigation"><a href="#services">Services</a><a href="#selected-work">Work</a><a href={bookingUrl} class="nav-book" target="_blank" rel="noopener noreferrer">Book a call ↗</a></nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner wrap">
          <div class="hero-copy">
            <p class="eyebrow"><span class="signal" aria-hidden="true"></span> Work directly with the person building it</p>
            <h1 id="hero-title">Your next idea.<br />Let’s make it <em>real.</em></h1>
            <p class="hero-description">I’m Big, a designer and developer. I build websites, apps and business tools that turn “we should” into something you can actually use.</p>
            <div class="hero-actions"><a href={bookingUrl} class="button primary" target="_blank" rel="noopener noreferrer">Book a 30-minute call ↗</a><a class="text-link" href="#services">Explore the services ↓</a></div>
            <p class="hero-note">30-minute intro · English / ไทย · No commitment</p>
          </div>
          <figure class="portrait"><Image src={portrait} alt="Bunyasit Fang, also known as Big" width={640} height={800} fit="cover" loading="eager" fetchpriority="high" /><figcaption><span>Bunyasit Fang</span><span>Design → build → handoff</span></figcaption></figure>
        </div>
        <div class="hero-foot wrap"><span>Independent by choice. Built with intention.</span><a href="#services">Find your starting point ↓</a></div>
      </section>
      <section id="services" class="wrap section" aria-labelledby="services-title">
        <div class="section-heading"><div><p class="eyebrow">01 / The offers</p><h2 id="services-title">A clear way<br />to get moving.</h2></div><p>Choose the outcome you need. We’ll agree the details before the first line of code.</p></div>
        <div class="offers">{packages.map((pkg, index) => <article class:list={['offer', { recommended: pkg.recommended }]} id={`service-${pkg.id}`}>
          <div class="offer-intro"><p class="eyebrow">{String(index + 1).padStart(2, '0')} / {pkg.label}{pkg.recommended && <span class="recommendation">For growing businesses</span>}</p><h3>{pkg.name}</h3><p>{pkg.tagline}</p><p class="offer-timing">{pkg.timeline} · Agreed scope</p></div>
          <div class="offer-scope"><ul>{pkg.scope.map(item => <li>{item}</li>)}</ul><p class="boundary">{pkg.boundary}</p></div>
          <div class="offer-price"><span class="price-caption">Project fee</span><p class="price">฿{formatThb(pkg.totalThb)}</p><p class="payment">{pkg.payment}</p><a class="button secondary" href="#project-inquiry" data-service={pkg.id}>Discuss this project ↗</a></div>
        </article>)}</div>
        <div class="custom-offer"><p><strong>Something more specific?</strong> AI workflow automation, an existing product that needs help, or ongoing improvements.</p><a href="#project-inquiry" data-service="custom" class="text-link">Tell me what you need ↗</a></div>
        <p class="pricing-note">All prices in THB. Third-party fees and any applicable taxes will be itemized in your written quote. Timelines depend on scope and timely feedback.</p>
      </section>
      <section id="selected-work" class="work-section" aria-labelledby="work-title"><div class="wrap section">
        <div class="section-heading"><div><p class="eyebrow">02 / Inside a build</p><h2 id="work-title">More than<br />a good-looking page.</h2></div><p>A storefront for customers. A working system for the people behind it.</p></div>
        <div class="project"><a href="/topoftherank" class="project-image" aria-label="Explore the Top of the Rank visual demo"><img src="/topoftherank/og.png" alt="Top of the Rank vehicle storefront design" width="1200" height="630" loading="lazy" /><span>Explore the visual demo <span aria-hidden="true">↗</span></span></a><div class="project-copy"><p class="eyebrow">Automotive / Custom business app</p><h3>Top of the Rank</h3><p>A luxury vehicle showroom backed by inventory, photo management and customer inquiry tools.</p><ul><li>Searchable showroom and individual car pages</li><li>Staff tools to manage vehicles, photos and availability</li><li>Lead management and promotional content</li></ul><p class="project-note">Storefront demo shown. Inventory and staff tools are part of the broader build.</p></div></div>
      </div></section>
      <section class="wrap section process" aria-labelledby="process-title"><div class="section-heading"><div><p class="eyebrow">03 / How we work</p><h2 id="process-title">Clear scope.<br />Visible progress.</h2></div><p>You know what’s being built, what comes next and when each payment is due.</p></div><ol class="process-steps"><li><span>01</span><h3>Talk it through</h3><p>We discuss the problem, the people using it and what success should look like.</p></li><li><span>02</span><h3>Agree the plan</h3><p>A written scope, responsibilities, review dates and milestones. Extras get their own quote.</p></li><li><span>03</span><h3>Try the real thing</h3><p>Review a working demo, give consolidated feedback and see the core flow in action.</p></li><li><span>04</span><h3>Launch & hand over</h3><p>Deploy, walk through the product together and receive the agreed code and documentation.</p></li></ol></section>
      <section class="booking-section" id="book" aria-labelledby="book-title"><div class="wrap section booking-layout">
        <div class="booking-copy"><p class="eyebrow">04 / Your next step</p><h2 id="book-title">Tell me what<br />you have in mind.</h2><p>A rough idea is enough. Pick a time on my calendar and let’s find the right first step for your project.</p><p class="thai-copy" lang="th">เล่าไอเดียเป็นภาษาไทยได้เลยครับ</p>{bookingUrl && <a class="button primary calendar-link" href={bookingUrl} target="_blank" rel="noopener noreferrer">Choose your time ↗</a>}<a class="email-link" href={`mailto:${workMeta.contactEmail}`}>{workMeta.contactEmail} ↗</a><p class="booking-note">Prefer email? Send your goal, budget and ideal start date directly.</p></div>
        <div class="booking-options"><div class="appointment"><div class="appointment-top"><span class="eyebrow">Your first conversation</span><span class="appointment-duration">30 min</span></div><h3>Big ideas start<br />with a small hello.</h3><p>Bring your idea, your questions, or the workflow that’s been slowing you down.</p><ul><li>Talk through what you want to build</li><li>Explore a sensible scope and budget</li><li>Leave with a clear next step</li></ul><a class="button primary" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a project call ↗</a><p class="appointment-note">Choose an available time in your timezone on Cal.com.</p></div><details class="brief-details"><summary>Prefer to send a project brief first?<span aria-hidden="true">+</span></summary><form id="project-inquiry" data-email={workMeta.contactEmail}>
          <div class="form-row"><div class="field"><label for="client-name">Your name <span>(required)</span></label><input id="client-name" name="name" autocomplete="name" required maxlength="100" placeholder="What should I call you?" /></div><div class="field"><label for="client-email">Email <span>(required)</span></label><input id="client-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@company.com" /></div></div>
          <div class="field"><label for="project-service">What can I help with?</label><select id="project-service" name="service"><option value="unsure">Help me choose</option>{packages.map(pkg => <option value={pkg.id}>{pkg.label} — ฿{formatThb(pkg.totalThb)}</option>)}<option value="custom">Custom project / AI / ongoing support</option></select></div>
          <div class="field"><label for="project-goal">What would you like to build? <span>(required)</span></label><textarea id="project-goal" name="goal" rows="4" required minlength="10" maxlength="2500" placeholder="Who is it for, and what should it help them do? Existing links are welcome."></textarea></div>
          <div class="form-row"><div class="field"><label for="project-budget">Project budget</label><select id="project-budget" name="budget"><option>Let’s discuss</option><option>Under ฿50,000</option><option>฿50,000–120,000</option><option>฿120,000–200,000</option><option>฿200,000–300,000</option><option>฿300,000+</option></select></div><div class="field"><label for="project-start">Ideal start</label><select id="project-start" name="start"><option>Flexible / exploring</option><option>Within a month</option><option>In 1–3 months</option><option>Have a fixed deadline</option></select></div></div>
          <div class="field"><label for="call-times">Preferred call times & timezone <span>(optional)</span></label><input id="call-times" name="times" maxlength="250" placeholder="e.g. Tue or Thu, 2–5 pm, Bangkok time" /></div>
          <p class="form-note" id="request-explainer">This prepares an email to Big. Send it from your email app to request a call. Your time is confirmed personally by email.</p>
          <button class="button primary" type="submit" aria-describedby="request-explainer" disabled>Prepare my call request ↗</button>
          <noscript><p class="form-note">The request builder needs JavaScript. Email <a href={`mailto:${workMeta.contactEmail}`}>{workMeta.contactEmail}</a> with your project details instead.</p></noscript>
          <div id="request-ready" class="request-ready" hidden aria-labelledby="request-ready-title"><h3 id="request-ready-title" tabindex="-1">Your email draft is ready.</h3><p>Send it to request your call. Nothing has been submitted yet.</p><a id="send-request" class="button primary" href={`mailto:${workMeta.contactEmail}`}>Open email & send ↗</a><label for="request-draft">No email app? Copy this draft and send it to {workMeta.contactEmail}.</label><textarea id="request-draft" rows="8" readonly></textarea><button id="copy-request" type="button" class="text-link">Copy email draft</button><p id="copy-status" role="status" aria-live="polite"></p></div>
        </form></details></div>
      </div></section>
      <section class="wrap section faq" aria-labelledby="faq-title"><div><p class="eyebrow">A few practical things</p><h2 id="faq-title">Before we begin.</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    </main>
    <footer class="wrap"><a href="/" class="wordmark">bigf<span>.me</span></a><p>Built with care. Let’s make something useful.</p><a href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a call ↗</a></footer>
  </div>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('#project-inquiry');
  const service = document.querySelector<HTMLSelectElement>('#project-service');
  const ready = document.querySelector<HTMLElement>('#request-ready');
  const draft = document.querySelector<HTMLTextAreaElement>('#request-draft');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (submit) submit.disabled = false;
  document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(link => {
    link.addEventListener('click', () => {
      const brief = document.querySelector<HTMLDetailsElement>('.brief-details');
      if (brief) brief.open = true;
      if (service) service.value = link.dataset.service || 'unsure';
      if (ready) ready.hidden = true;
      document.querySelector<HTMLInputElement>('#client-name')?.focus({ preventScroll: true });
    });
  });
  form?.addEventListener('input', event => { if (ready && !(event.target as HTMLElement).closest('#request-ready')) ready.hidden = true; });
  form?.addEventListener('submit', event => {
    event.preventDefault();
    if (!form.reportValidity() || !draft || !ready) return;
    const data = new FormData(form);
    const get = (key: string) => String(data.get(key) || '').trim();
    const body = `Hi Big,\n\nI’d like to discuss a project and arrange a 30-minute call.\n\nName: ${get('name')}\nReply email: ${get('email')}\nService: ${service?.selectedOptions[0]?.textContent}\nBudget: ${get('budget')}\nIdeal start: ${get('start')}\nPreferred call times & timezone: ${get('times') || 'Please suggest a time'}\n\nWhat I’d like to build:\n${get('goal')}\n\nPlease let me know the next step. Thank you!`;
    draft.value = body;
    const send = document.querySelector<HTMLAnchorElement>('#send-request');
    if (send) send.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Project call request — ${get('name').replace(/[\r\n]/g, ' ')}`)}&body=${encodeURIComponent(body)}`;
    const status = document.querySelector<HTMLElement>('#copy-status');
    if (status) status.textContent = '';
    ready.hidden = false;
    document.querySelector<HTMLElement>('#request-ready-title')?.focus();
  });
  document.querySelector('#copy-request')?.addEventListener('click', async () => {
    if (!draft) return;
    const status = document.querySelector<HTMLElement>('#copy-status');
    try { await navigator.clipboard.writeText(draft.value); if (status) status.textContent = 'Copied. Paste this into an email to Big.'; }
    catch { draft.focus(); draft.select(); if (status) status.textContent = 'Select and copy the draft above, then paste it into your email.'; }
  });
</script>
<style>
  :global(html:has(.services)) { scroll-behavior:smooth; scroll-padding-top:100px; overflow-x:clip; }
  :global(body:has(.services)) { overflow-x:clip; }
  .services .button.primary { color:#151017; }
  :global(.services), :global(.services *) { cursor:auto !important; }
  :global(.services a), :global(.services button), :global(.services summary), :global(.services select) { cursor:pointer !important; }
  :global(body:has(.services) #cursor-dot) { display:none; }
  .services { --accent:#ff85ab; --muted:#aaa9b7; --line:#2b2933; color:#f4f1ee; background:#101015; font-family:var(--font-sans); }
  .services a { text-decoration:none; color:inherit; }
  .services :is(a,button,input,textarea,select,summary):focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  .wrap { width:min(1280px,calc(100% - clamp(40px,7vw,128px))); margin-inline:auto; }
  .studio-nav { display:flex; align-items:center; justify-content:space-between; padding:20px clamp(20px,3.5vw,64px); min-height:76px; position:sticky; top:0; z-index:20; background:#101015f5; border-bottom:1px solid var(--line); }
  .wordmark { font-family:var(--font-display); font-size:27px; font-weight:700; letter-spacing:-1px; display:flex; align-items:center; }
  .wordmark>span:first-child { color:var(--accent); }
  .nav-divider { color:#55505e; margin:0 23px; font-weight:400; }
  .nav-label { font-family:var(--font-sans); font-size:13px; font-weight:400; letter-spacing:0; color:var(--muted); }
  nav { display:flex; align-items:center; gap:30px; font-size:14px; } nav a { transition:color .2s; } nav a:hover { color:var(--accent); } .nav-book { border-bottom:1px solid var(--accent); padding-block:7px; }
  .hero { position:relative; overflow:hidden; border-bottom:1px solid var(--line); }
  .hero-inner { min-height:min(650px,calc(100svh - 140px)); display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr); align-items:center; gap:clamp(28px,4vw,64px); padding-block:clamp(44px,7vh,80px); }
  .hero-copy { position:relative; z-index:2; animation:arrive .65s ease-out both; }
  .eyebrow { font-size:11px; font-family:var(--font-mono); letter-spacing:1.6px; text-transform:uppercase; color:var(--muted); margin:0 0 24px; line-height:1.7; }
  .signal { display:inline-block; width:6px; height:6px; background:var(--accent); border-radius:50%; margin-right:9px; }
  h1,h2,h3,p { margin-top:0; } h1,h2,h3 { font-family:var(--font-display); font-weight:500; }
  h1 { font-size:clamp(42px,6.1vw,92px); line-height:1.04; letter-spacing:-.055em; text-wrap:balance; margin-bottom:28px; } h1 em { font-style:normal; color:var(--accent); }
  .hero-description { max-width:480px; font-size:19px; line-height:1.65; color:var(--muted); margin-bottom:30px; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:24px; } .button { min-height:49px; display:inline-flex; align-items:center; justify-content:center; gap:22px; padding:14px 22px; font:500 14px var(--font-sans); border:1px solid transparent; border-radius:4px; transition:background .2s,transform .2s,border-color .2s; }
  .button:hover { transform:translateY(-2px); } .button.primary { background:var(--accent); color:#151017; } .button.primary:hover { background:#ffa0bd; } .button.secondary { border-color:#504450; background:transparent; color:#f4f1ee; } .button.secondary:hover { border-color:var(--accent); }
  .text-link { font:500 14px var(--font-sans); border:0; background:none; padding:10px 0; color:inherit; } .text-link:hover { color:var(--accent); }
  .hero-note { color:var(--muted); font-size:12px; margin:18px 0 0; }
  .portrait { margin:0; position:relative; animation:arrive .85s .1s ease-out both; } .portrait img { width:100%; height:clamp(340px,35vw,490px); object-fit:cover; object-position:center 40%; filter:grayscale(1); border-radius:45% 45% 4px 4px; } .portrait figcaption { display:flex; justify-content:space-between; gap:12px; font-size:11px; color:var(--muted); margin-top:15px; } .portrait figcaption span:first-child { color:#f4f1ee; }
  .hero-foot { display:flex; justify-content:space-between; padding-block:23px; border-top:1px solid var(--line); font-size:12px; color:var(--muted); } .hero-foot a { color:var(--accent); }
  .section { padding-block:clamp(64px,8vw,112px); } .section-heading { display:flex; justify-content:space-between; align-items:end; gap:40px; margin-bottom:52px; } .section-heading>p { max-width:305px; color:var(--muted); line-height:1.7; font-size:16px; margin-bottom:4px; } h2 { font-size:clamp(34px,4.5vw,60px); letter-spacing:-2px; line-height:1.08; margin-bottom:0; }
  .offer { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1.1fr) minmax(210px,.75fr); gap:36px; padding:38px 0; border-top:1px solid var(--line); scroll-margin-top:100px; } .offer.recommended { border-top-color:var(--accent); } .offer:last-child { border-bottom:1px solid var(--line); } .offer .eyebrow { margin-bottom:14px; } .recommendation { display:block; color:var(--accent); font-size:9px; letter-spacing:.5px; }
  .offer h3 { font-size:28px; letter-spacing:-.8px; line-height:1.15; margin-bottom:14px; max-width:280px; } .offer-intro>p:not(.eyebrow) { font-size:14px; line-height:1.7; color:var(--muted); } .offer-intro .offer-timing { font-size:12px; margin:20px 0 0; color:#d8d2db; }
  .offer-scope ul,.project-copy ul { list-style:none; padding:0; margin:0; } .offer-scope li,.project-copy li { position:relative; padding-left:21px; font-size:14px; line-height:1.6; margin-bottom:11px; color:#d0cbd4; } .offer-scope li::before,.project-copy li::before { content:'↗'; position:absolute; left:0; color:var(--accent); font-size:12px; }
  .boundary { font-size:12px; line-height:1.6; color:var(--muted); margin:20px 0 0; } .price-caption { font-size:11px; color:var(--muted); } .price { font-size:35px; font-family:var(--font-display); letter-spacing:-1px; margin:5px 0 13px; white-space:nowrap; } .payment { font-size:11px; line-height:1.8; color:var(--muted); min-height:40px; } .offer-price .button { font-size:12px; padding:12px 15px; gap:15px; width:100%; }
  .custom-offer { display:flex; align-items:center; justify-content:space-between; gap:24px; margin-top:32px; } .custom-offer p { color:var(--muted); font-size:14px; line-height:1.7; max-width:650px; margin:0; } .custom-offer strong { color:#f4f1ee; font-weight:500; } .custom-offer a { white-space:nowrap; color:var(--accent); } .pricing-note { font-size:11px; line-height:1.7; color:var(--muted); margin:25px 0 0; }
  .work-section { background:#17161d; border-block:1px solid var(--line); } .project { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(0,1fr); gap:60px; align-items:center; } .project-image { display:block; background:#090b0d; overflow:hidden; border-radius:4px; } .project-image img { width:100%; height:auto; display:block; transition:transform .45s; } .project-image:hover img { transform:scale(1.035); } .project-image>span { display:flex; justify-content:space-between; font-size:12px; padding:19px 22px; border-top:1px solid var(--line); } .project-copy h3 { font-size:35px; letter-spacing:-1px; margin-bottom:17px; } .project-copy>p:not(.eyebrow) { color:var(--muted); font-size:15px; line-height:1.7; } .project-copy ul { margin-top:23px; } .project-copy .project-note { font-size:11px !important; margin:25px 0 0; }
