---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import Notebook from '../components/Notebook.astro';
import Gallery from '../components/Gallery.astro';
import ShadowCatcher from '../components/ShadowCatcher.astro';
import Dashboard from '../components/Dashboard.astro';
---

<Layout title="bigf.me • Bunyasit Fang">
  <!-- Desktop: Canvas Viewport -->
  <main class="canvas-viewport canvas-bg relative select-none hidden md:block" style="touch-action: none; overscroll-behavior: none;" id="viewport">
    
    <!-- Canvas Surface -->
    <div id="canvas" class="canvas-surface transition-none">
      
      <!-- Coordinate Origin Marker (hidden by default, useful for debug or aesthetics) -->
      <div class="absolute left-0 top-0 w-4 h-4 -ml-2 -mt-2 border border-[#a09e99]/30 rounded-full opacity-50 flex items-center justify-center pointer-events-none">
        <div class="w-1 h-1 bg-[#a09e99] rounded-full"></div>
      </div>

      <!-- Item 1: Life Dashboard -->
      <div class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 z-20 canvas-item group" data-workspace="terminal">
        <div class="absolute -top-8 left-0 text-[#a09e99] font-display text-sm opacity-60 uppercase tracking-[0.15em] pointer-events-none font-bold">Workspace 01 : Reflections</div>
        <div class="w-[90vw] max-w-7xl h-[85vh] shadow-[0_30px_80px_rgba(0,0,0,0.6)] rounded-[3rem] overflow-hidden resize transition-transform duration-300 group-hover:scale-[1.01]">
          <Dashboard />
        </div>
      </div>

      <!-- Item 2: Notebook -->
      <div class="absolute top-0 left-[1200px] -translate-x-1/2 -translate-y-1/2 z-10 canvas-item group" data-workspace="notebook">
         <div class="absolute -top-8 left-0 text-[#a09e99] font-display text-sm opacity-60 uppercase tracking-[0.15em] pointer-events-none font-bold">Workspace 02 : Thoughts</div>
        <div class="w-[90vw] max-w-5xl h-[80vh] overflow-hidden resize transition-transform duration-300 group-hover:scale-[1.01]">
          <Notebook />
        </div>
      </div>

      <!-- Item 3: Gallery -->
      <div class="absolute top-0 left-[2400px] -translate-x-1/2 -translate-y-1/2 z-10 canvas-item group" data-workspace="gallery">
         <div class="absolute -top-8 left-0 text-[#a09e99] font-display text-sm opacity-60 uppercase tracking-[0.15em] pointer-events-none font-bold">Workspace 03 : Gallery</div>
        <div class="w-[90vw] max-w-5xl h-[80vh] overflow-hidden resize transition-transform duration-300 group-hover:scale-[1.01]">
          <Gallery />
        </div>
      </div>

      <!-- Item 4: Shadow Catcher -->
      <div class="absolute top-0 left-[-1200px] -translate-x-1/2 -translate-y-1/2 z-10 canvas-item group" data-workspace="shadow">
        <div class="absolute -top-8 left-0 text-[#a09e99] font-display text-sm opacity-60 uppercase tracking-[0.15em] pointer-events-none font-bold">Workspace 04 : Shadows</div>
        <div class="w-[90vw] max-w-[420px] h-[80vh] overflow-hidden resize transition-transform duration-300 group-hover:scale-[1.01]">
          <ShadowCatcher />
        </div>
      </div>

    </div>
  </main>

  <!-- Mobile: Fullscreen Swipeable Workspaces -->
  <main id="mobile-viewport" class="md:hidden fixed inset-0 w-screen h-screen overflow-x-auto overflow-y-hidden flex scroll-smooth snap-x snap-mandatory" style="scroll-snap-type: x mandatory; touch-action: pan-x; scrollbar-width: none;">
    <!-- Workspace 1: Dashboard -->
    <div class="mobile-workspace flex-shrink-0 w-screen h-screen snap-start relative" data-workspace="terminal">
      <div class="w-full h-full p-0">
        <Dashboard />
      </div>
    </div>
    <!-- Workspace 2: Notebook -->
    <div class="mobile-workspace flex-shrink-0 w-screen h-screen snap-start relative" data-workspace="notebook">
      <div class="w-full h-full p-0">
        <Notebook />
      </div>
    </div>
    <!-- Workspace 3: Gallery -->
    <div class="mobile-workspace flex-shrink-0 w-screen h-screen snap-start relative" data-workspace="gallery">
      <div class="w-full h-full p-0">
        <Gallery />
      </div>
    </div>
    <!-- Workspace 4: Shadow Catcher -->
    <div class="mobile-workspace flex-shrink-0 w-screen h-screen snap-start relative" data-workspace="shadow">
      <div class="w-full h-full p-0">
        <ShadowCatcher />
      </div>
    </div>

    <!-- Mobile Navigation Dots -->
    <div id="mobile-nav" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 md:hidden">
      <div class="bg-[#0a0a0f]/90 backdrop-blur-md border border-[#2a2a3f]/80 shadow-[0_5px_25px_rgba(0,0,0,0.5)] rounded-full px-4 py-2 flex items-center gap-4">
        <button class="text-[#8a8899] hover:text-white active:scale-95 transition-all p-1 cursor-pointer" id="btn-home" title="Go to Life Dashboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>
        <button class="text-[#8a8899] hover:text-[#ff6b9d] active:scale-95 transition-all p-1 cursor-pointer" id="btn-notebook" title="Go to Notebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>
        <button class="text-[#8a8899] hover:text-[#ff9f1c] active:scale-95 transition-all p-1 cursor-pointer" id="btn-gallery" title="Go to Gallery">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>
        <button class="text-[#8a8899] hover:text-[#a78bfa] active:scale-95 transition-all p-1 cursor-pointer" id="btn-shadows" title="Go to Shadow Catcher">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
        </button>
      </div>
    </div>
  </main>

  <!-- Desktop Navigation + Terminal Overlay -->
  <div class="hidden md:block">
    <!-- UI Overlay Controls / Navigation -->
    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 z-50 w-auto">
      <!-- Main Navigation Bar -->
      <div class="bg-[#0a0a0f]/90 backdrop-blur-md border border-[#2a2a3f]/80 shadow-[0_5px_25px_rgba(0,0,0,0.5)] rounded-full px-4 py-2 flex items-center gap-4">
        <!-- Home / Life Dashboard (Workspace 1) -->
        <button class="text-[#8a8899] hover:text-white active:scale-95 transition-all p-1 cursor-pointer" id="btn-home" title="Go to Life Dashboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>

        <!-- Terminal Overlay Toggler -->
        <button class="text-[#8a8899] hover:text-[#00d4ff] active:scale-95 transition-all p-1 cursor-pointer" id="btn-terminal-toggle" title="Toggle Terminal Command Prompt">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5" />
            <line x1="12" y1="19" x2="20" y2="19" />
          </svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>

        <!-- Notebook (Workspace 2) -->
        <button class="text-[#8a8899] hover:text-[#ff6b9d] active:scale-95 transition-all p-1 cursor-pointer" id="btn-notebook" title="Go to Notebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>

        <!-- Gallery (Workspace 3) -->
        <button class="text-[#8a8899] hover:text-[#ff9f1c] active:scale-95 transition-all p-1 cursor-pointer" id="btn-gallery" title="Go to Gallery">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>

        <!-- Shadows (Workspace 4) -->
        <button class="text-[#8a8899] hover:text-[#a78bfa] active:scale-95 transition-all p-1 cursor-pointer" id="btn-shadows" title="Go to Shadow Catcher">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
        </button>
        <div class="w-[1px] h-4 bg-[#2a2a3f]/50"></div>

        <!-- Zoom Out / Overview -->
        <button class="text-[#8a8899] hover:text-[#e8e6e1] active:scale-95 transition-all items-center gap-1 flex cursor-pointer" id="btn-zoom-out" title="Overview">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </button>
      </div>
    </div>

    <!-- Floating Expandable Terminal Overlay -->
    <div id="terminal-overlay" class="fixed inset-x-0 bottom-24 mx-auto w-[90vw] max-w-5xl h-[55vh] z-[60] hidden transition-all duration-300 translate-y-10 opacity-0 pointer-events-none">
      <div class="w-full h-full shadow-[0_30px_100px_rgba(0,0,0,0.8)] border border-[#2a2a3f] rounded-[2.5rem] bg-[#0a0a0f]/95 backdrop-blur-xl overflow-hidden relative p-1 flex flex-col">
        <!-- Close overlay button -->
        <button id="terminal-overlay-close" class="absolute top-5 right-8 text-[#8a8899] hover:text-[#ff6b9d] transition-colors text-[10px] font-mono uppercase tracking-widest cursor-pointer select-none z-[65]" type="button">
          ✕ Close
        </button>
        <Terminal />
      </div>
    </div>

  </div>
</Layout>

<style>
  .canvas-item {
    /* Prevent grabbing canvas when interacting inside items unless space is down */
    cursor: auto;
  }
  .is-panning {
    cursor: grabbing !important;
  }
  .is-panning .canvas-item {
    pointer-events: none; /* Disable interaction with children while panning */
  }
  /* Fix terminal internal components interacting with panning */
  :global(#terminal-output) {
    overscroll-behavior: contain;
  }

  /* Resize handle styling for workspace windows */
  .canvas-item > div > div {
    resize: both;
  }
  .canvas-item > div > div::-webkit-resizer {
    background: transparent;
    border-right: 3px solid #ff6b9d;
    border-bottom: 3px solid #ff6b9d;
    border-radius: 0 0 3rem 0;
  }
  .canvas-item > div > div:hover::-webkit-resizer {
    border-right-color: #00d4ff;
    border-bottom-color: #00d4ff;
  }

  /* Mobile nav indicator */
  .mobile-nav-active {
    color: #ff6b9d !important;
  }

  /* Mobile viewport hide scrollbar */
  #mobile-viewport::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const viewport = document.getElementById('viewport');
  const canvas = document.getElementById('canvas');
  if (viewport && canvas) {
    // Canvas State
    let state = {
      x: window.innerWidth / 2, 
      y: window.innerHeight / 2,
      scale: 1,
      isPanning: false,
      spaceBarDown: false,
      lastMouse: { x: 0, y: 0 }
    };

    // Ensure transform origin is 0 0 so zoom math perfectly aligns
    canvas.style.transformOrigin = '0 0';

    // Cursor Logic
    const moveCursor = (e: MouseEvent) => {
      // Hover states (canvas-specific; position handled by CustomCursor in Layout)
      const target = e.target as HTMLElement;
      const isText = target.closest('input, textarea');
      const isOverview = state.scale < 0.9;
      const isHoverable = target.closest('button, a, [role="button"], .cursor-pointer') || (isOverview && target.closest('.canvas-item'));
      
      if (isText) {
        document.body.classList.add('cursor-text-hover');
        document.body.classList.remove('cursor-hover');
      } else if (isHoverable) {
        document.body.classList.add('cursor-hover');
        document.body.classList.remove('cursor-text-hover');
      } else {
        document.body.classList.remove('cursor-hover', 'cursor-text-hover');
      }
    };

    // Rendering
    let frameRequested = false;
    const requestUpdate = (animate = false) => {
      if (!frameRequested) {
        frameRequested = true;
        requestAnimationFrame(() => {
          if (animate) {
            canvas.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
          } else {
            canvas.style.transition = 'none';
          }
          canvas.style.transform = `translate(${state.x}px, ${state.y}px) scale(${state.scale})`;
          frameRequested = false;
        });
      }
    };

    // Initial position
    requestUpdate();

    // Event Handlers
    const handleWheel = (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.custom-scrollbar') || target.closest('.custom-scrollbar-pirate') || target.closest('#terminal-output')) {
        if (Math.abs(state.scale - 1) < 0.01 && !e.ctrlKey && !e.metaKey) return;
      }

      e.preventDefault();

      const { deltaX, deltaY, clientX, clientY } = e;
      const isZoom = e.ctrlKey || e.metaKey;

      if (isZoom) {
        // High-precision zoom pivot with standard sensitivity
        const zoomSpeed = 0.01;
        const zoomFactor = Math.exp(-deltaY * zoomSpeed);
        const newScale = Math.max(0.05, Math.min(state.scale * zoomFactor, 10));
        
        const scaleDelta = newScale / state.scale;
        
        state.x = clientX - (clientX - state.x) * scaleDelta;
        state.y = clientY - (clientY - state.y) * scaleDelta;
        state.scale = newScale;
      } else {
        // Pan
        state.x -= deltaX;
        state.y -= deltaY;
      }
      
      requestUpdate();
    };

    const handleMouseDown = (e: MouseEvent) => {
      document.body.classList.add('cursor-clicking');
      // Figma UX: Spacebar, background click, or Middle Mouse Button (button === 1) to pan.
      if (e.button === 1 || state.spaceBarDown || e.target === viewport || e.target === canvas) {
        e.preventDefault();
        state.isPanning = true;
        viewport.classList.add('is-panning');
        document.body.classList.add('cursor-panning');
        document.body.setAttribute('data-is-panning', 'true');
        
        state.lastMouse.x = e.clientX;
        state.lastMouse.y = e.clientY;
      }
    };

    const handleMouseMove = (e) => {
      moveCursor(e);
      if (state.isPanning) {
        state.x += e.clientX - state.lastMouse.x;
        state.y += e.clientY - state.lastMouse.y;
        requestUpdate();
      }
      state.lastMouse.x = e.clientX;
      state.lastMouse.y = e.clientY;
    };

    const handleMouseUp = () => {
      document.body.classList.remove('cursor-clicking');
      state.isPanning = false;
      viewport.classList.remove('is-panning');
      document.body.classList.remove('cursor-panning');
      document.body.removeAttribute('data-is-panning');
    };

    // Touch Support Logic
    let lastTouchDistance = 0;
    let isTouchPanning = false;

    const handleTouchStart = (e: TouchEvent) => {
      if (e.touches.length === 1) {
        isTouchPanning = true;
        state.lastMouse.x = e.touches[0].clientX;
        state.lastMouse.y = e.touches[0].clientY;
      } else if (e.touches.length === 2) {
        lastTouchDistance = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
      }
    };

    const handleTouchMove = (e: TouchEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      
      if (e.touches.length === 1 && isTouchPanning) {
        const dx = e.touches[0].clientX - state.lastMouse.x;
        const dy = e.touches[0].clientY - state.lastMouse.y;
        state.x += dx;
        state.y += dy;
        state.lastMouse.x = e.touches[0].clientX;
        state.lastMouse.y = e.touches[0].clientY;
        requestUpdate();
      } else if (e.touches.length === 2) {
        const distance = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        
        const centerX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
        const centerY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
        
        const zoomFactor = distance / lastTouchDistance;
        const newScale = Math.max(0.1, Math.min(state.scale * zoomFactor, 5));
        
        const worldX = (centerX - state.x) / state.scale;
        const worldY = (centerY - state.y) / state.scale;
        
        state.scale = newScale;
        state.x = centerX - worldX * state.scale;
        state.y = centerY - worldY * state.scale;
        
        lastTouchDistance = distance;
        requestUpdate();
      }
    };

    const handleTouchEnd = () => {
      isTouchPanning = false;
      lastTouchDistance = 0;
    };

    // Bindings
    window.addEventListener('wheel', handleWheel, { passive: false });
    window.addEventListener('mousedown', handleMouseDown);
    window.addEventListener('mousemove', handleMouseMove, { passive: true });
    window.addEventListener('mouseup', handleMouseUp);
    
    // Touch Bindings
    window.addEventListener('touchstart', handleTouchStart, { passive: false });
    window.addEventListener('touchmove', handleTouchMove, { passive: false });
    window.addEventListener('touchend', handleTouchEnd);
    
    // Resize handler to maintain centering
    window.addEventListener('resize', () => {
      requestUpdate();
    });
    
    // Spacebar listener
    window.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.code === 'Space' && !state.spaceBarDown) {
        e.preventDefault();
        state.spaceBarDown = true;
        // cursor-panning class handles visual feedback
        document.body.classList.add('cursor-panning');
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'Space') {
        state.spaceBarDown = false;
        if (!state.isPanning) document.body.classList.remove('cursor-panning');
      }
    });

    // Native gesture blocking and handling for Mac Safari/Chrome
    let gestureStartScale = 1;
    window.addEventListener('gesturestart', (e: any) => {
      e.preventDefault();
      gestureStartScale = state.scale;
    });
    window.addEventListener('gesturechange', (e: any) => {
      e.preventDefault();
      const newScale = Math.max(0.05, Math.min(gestureStartScale * e.scale, 10));
      const scaleDelta = newScale / state.scale;
      
      const cursorX = e.clientX;
      const cursorY = e.clientY;
      
      state.x = cursorX - (cursorX - state.x) * scaleDelta;
      state.y = cursorY - (cursorY - state.y) * scaleDelta;
      state.scale = newScale;
      requestUpdate();
    });
    window.addEventListener('gestureend', (e: any) => e.preventDefault());
    
    document.getElementById('btn-zoom-out')?.addEventListener('click', () => {
      // Center and show all (since workspaces span from -1200 to 2400, center is 600)
      state.x = (window.innerWidth / 2) - (600 * 0.3); 
      state.y = window.innerHeight / 2;
      state.scale = 0.3;
      requestUpdate(true);
    });

    // Active workspace list & tracker
    const WORKSPACES = ['shadow', 'terminal', 'notebook', 'gallery'];
    let currentActiveWorkspace = 'terminal';

    // Floating Terminal Overlay Expand/Collapse Logic
    const terminalToggleBtn = document.getElementById('btn-terminal-toggle');
    const terminalOverlay = document.getElementById('terminal-overlay');
    const terminalOverlayClose = document.getElementById('terminal-overlay-close');
    const terminalInput = document.getElementById('terminal-input') as HTMLInputElement;

    const openTerminalOverlay = () => {
      if (!terminalOverlay) return;
      terminalOverlay.classList.remove('hidden');
      void terminalOverlay.offsetHeight; // force reflow for smooth animations
      terminalOverlay.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
      terminalOverlay.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      
      // Auto focus terminal input on open
      setTimeout(() => {
        if (terminalInput) terminalInput.focus();
      }, 100);
    };

    const closeTerminalOverlay = () => {
      if (!terminalOverlay) return;
      terminalOverlay.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      terminalOverlay.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
      
      setTimeout(() => {
        terminalOverlay.classList.add('hidden');
      }, 300);
    };

    terminalToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (terminalOverlay && terminalOverlay.classList.contains('hidden')) {
        openTerminalOverlay();
      } else {
        closeTerminalOverlay();
      }
    });

    terminalOverlayClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeTerminalOverlay();
    });

    // Close overlay if clicking outside or pressing Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && terminalOverlay && !terminalOverlay.classList.contains('hidden')) {
        closeTerminalOverlay();
      }
    });

    window.addEventListener('mousedown', (e) => {
      if (terminalOverlay && !terminalOverlay.classList.contains('hidden')) {
        const target = e.target as HTMLElement;
        if (!target.closest('#terminal-overlay') && !target.closest('#btn-terminal-toggle')) {
          closeTerminalOverlay();
        }
      }
    });

    // Mobile nav buttons logic using unified canvas:navigate
    document.getElementById('btn-home')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('canvas:navigate', { detail: { workspace: 'terminal' } }));
    });
    document.getElementById('btn-notebook')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('canvas:navigate', { detail: { workspace: 'notebook' } }));
    });
    document.getElementById('btn-gallery')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('canvas:navigate', { detail: { workspace: 'gallery' } }));
    });
    document.getElementById('btn-shadows')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('canvas:navigate', { detail: { workspace: 'shadow' } }));
    });

    // Global canvas navigation event listener with workspace tracking
    window.addEventListener('canvas:navigate', (e: any) => {
      // Smoothly collapse terminal overlay whenever navigation is triggered (whether by command or direct click)
      closeTerminalOverlay();

      const workspace = e.detail.workspace;
      if (workspace === 'shadow') {
        state.x = (window.innerWidth / 2) + 1200;
        state.y = window.innerHeight / 2;
        state.scale = 1;
        currentActiveWorkspace = 'shadow';
        requestUpdate(true);
      } else if (workspace === 'terminal' || workspace === 'home') {
        state.x = window.innerWidth / 2;
        state.y = window.innerHeight / 2;
        state.scale = 1;
        currentActiveWorkspace = 'terminal';
        requestUpdate(true);
      } else if (workspace === 'notebook') {
        state.x = (window.innerWidth / 2) - (1200 * 1);
        state.y = window.innerHeight / 2;
        state.scale = 1;
        currentActiveWorkspace = 'notebook';
        requestUpdate(true);
      } else if (workspace === 'gallery') {
        state.x = (window.innerWidth / 2) - (2400 * 1);
        state.y = window.innerHeight / 2;
        state.scale = 1;
        currentActiveWorkspace = 'gallery';
        requestUpdate(true);
      }
    });

    // Command + Left/Right arrow key navigation
    window.addEventListener('keydown', (e) => {
      const isCmd = e.metaKey || e.ctrlKey;
      if (isCmd && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
        // Exclude text input/textareas except terminal-input and shadow-pin-input
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) {
          const allowedInputs = ['terminal-input', 'shadow-pin-input'];
          if (!allowedInputs.includes(e.target.id)) return;
        }

        e.preventDefault();
        const currentIndex = WORKSPACES.indexOf(currentActiveWorkspace);
        let nextIndex = currentIndex;

        if (e.key === 'ArrowLeft') {
          // Go left: shadow <- terminal <- notebook <- gallery
          if (currentIndex > 0) {
            nextIndex = currentIndex - 1;
          }
        } else {
          // Go right: shadow -> terminal -> notebook -> gallery
          if (currentIndex < WORKSPACES.length - 1) {
            nextIndex = currentIndex + 1;
          }
        }

        if (nextIndex !== currentIndex) {
          const nextWorkspace = WORKSPACES[nextIndex];
          window.dispatchEvent(new CustomEvent('canvas:navigate', { detail: { workspace: nextWorkspace } }));
        }
      }
    });

    // Click-to-focus on canvas items (workspaces)
    document.querySelectorAll('.canvas-item').forEach(item => {
      item.addEventListener('click', (e) => {
        // If clicking inside interactive child elements, let standard behavior handle it
        const target = e.target as HTMLElement;
        if (target.closest('button, a, input, textarea, [role="button"], .shadow-behavior-chip, .shadow-keypad-btn')) return;
        
        // Skip if currently dragging/panning
        if (state.isPanning) return;
        
        const workspace = item.getAttribute('data-workspace');
        
        // Avoid jump triggering if we are already zoomed in and centered on it
        const currentScale = state.scale;
        let isAlreadyCentered = false;
        
        if (Math.abs(currentScale - 1) < 0.05) {
          if (workspace === 'terminal' && Math.abs(state.x - window.innerWidth / 2) < 50) isAlreadyCentered = true;
          if (workspace === 'notebook' && Math.abs(state.x - ((window.innerWidth / 2) - 1200)) < 50) isAlreadyCentered = true;
          if (workspace === 'gallery' && Math.abs(state.x - ((window.innerWidth / 2) - 2400)) < 50) isAlreadyCentered = true;
          if (workspace === 'shadow' && Math.abs(state.x - ((window.innerWidth / 2) + 1200)) < 50) isAlreadyCentered = true;
        }

        if (workspace && !isAlreadyCentered) {
          window.dispatchEvent(new CustomEvent('canvas:navigate', { detail: { workspace } }));
        }
      });
    });
  }

  // Mobile: swipeable workspace navigation
  const mobileViewport = document.getElementById('mobile-viewport');
  if (mobileViewport) {
    const MOBILE_WORKSPACES = ['terminal', 'notebook', 'gallery', 'shadow'];
    let mobileNavIndex = 0;

    const updateMobileNav = (index: number) => {
      mobileNavIndex = index;
      const buttons = mobileViewport.parentElement?.querySelectorAll('#mobile-nav button') as NodeListOf<HTMLElement>;
      buttons?.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add('mobile-nav-active');
        } else {
          btn.classList.remove('mobile-nav-active');
        }
      });
    };

    // Snap scroll tracking
    const mobileObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const ws = (entry.target as HTMLElement).getAttribute('data-workspace');
          const index = MOBILE_WORKSPACES.indexOf(ws || '');
          if (index !== -1) updateMobileNav(index);
        }
      });
    }, { root: mobileViewport, threshold: 0.5 });

    document.querySelectorAll('.mobile-workspace').forEach(ws => {
      mobileObserver.observe(ws);
    });

    // Mobile nav buttons - scroll to workspace
    const scrollToWorkspace = (index: number) => {
      const workspace = mobileViewport.children[index] as HTMLElement;
      if (workspace) {
        workspace.scrollIntoView({ behavior: 'smooth', inline: 'start' });
      }
    };

    document.querySelector('#mobile-nav #btn-home')?.addEventListener('click', () => scrollToWorkspace(0));
    document.querySelector('#mobile-nav #btn-notebook')?.addEventListener('click', () => scrollToWorkspace(1));
    document.querySelector('#mobile-nav #btn-gallery')?.addEventListener('click', () => scrollToWorkspace(2));
    document.querySelector('#mobile-nav #btn-shadows')?.addEventListener('click', () => scrollToWorkspace(3));

    // Initialize active state
    updateMobileNav(0);
  }
</script>

