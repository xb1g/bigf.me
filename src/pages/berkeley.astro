---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import gateImg from '../assets/images/gate.jpeg';
import skiImg from '../assets/images/ski.jpeg';
import yose1Img from '../assets/images/yose1.jpeg';
import yose2Img from '../assets/images/yose2.jpeg';
import tahoeGroupImg from '../assets/images/tahoe_group.jpeg';
import thaiFriendImg from '../assets/images/thai friend.jpeg';
import momImg from '../assets/images/mom.jpeg';
import berkeleyTransactions from '../data/berkeley_transactions.json';
---

<Layout title="UC Berkeley Exchange Report · Bunyasit (Big) Fang">
  <div class="berkeley-page min-h-screen bg-[#07070a] text-[#e2e8f0] flex flex-col monitor-warp pb-28 overflow-x-hidden font-sans select-none">
    <div class="vaporwave-bg opacity-20 fixed inset-0 pointer-events-none"></div>

    <!-- Sticky Navigation Bar & Global Controls -->
    <nav class="sticky top-0 z-50 backdrop-blur-md bg-[#07070a]/90 border-b border-[#2a2a3f]/80 px-4 md:px-8 py-3 transition-all">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-4">
          <a href="/" class="font-mono text-sm text-[#ff6b9d] hover:text-[#5cceff] transition-colors flex items-center gap-2 font-medium">
            <span aria-hidden="true">←</span> <span class="tracking-wide">bigf.me</span>
          </a>
          <span class="text-[#2a2a3f] hidden sm:inline">|</span>
          <span class="font-mono text-xs text-[#94a3b8] hidden sm:inline" data-i18n="navTitle">UC Berkeley Spring 2026</span>
        </div>

        <!-- Quick Jump Section Links -->
        <div class="hidden lg:flex items-center gap-4 text-xs font-mono text-[#94a3b8]">
          <a href="#overview" class="hover:text-white transition-colors" data-i18n="navOverview">Overview</a>
          <a href="#breakdown" class="hover:text-white transition-colors" data-i18n="navBreakdown">All Expenses</a>
          <a href="#inflows" class="hover:text-white transition-colors" data-i18n="navInflows">Inflows & Banking</a>
          <a href="#food" class="hover:text-white transition-colors" data-i18n="navFood">Food Discipline</a>
          <a href="#ledger" class="hover:text-[#39ff14] text-[#39ff14] font-bold transition-colors" data-i18n="navLedger">346 Transactions</a>
          <a href="#documents" class="hover:text-white transition-colors" data-i18n="navDocuments">Documents</a>
        </div>

        <!-- Controls: Currency & Language -->
        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
          <!-- Currency Toggle -->
          <div class="flex items-center bg-[#15151f] border border-[#2a2a3f] rounded-full p-0.5 text-xs font-mono" role="group" aria-label="Currency selection">
            <button type="button" data-curr="THB" class="curr-btn px-2.5 py-1 rounded-full bg-[#39ff14]/20 text-[#39ff14] font-bold border border-[#39ff14]/30 transition-all cursor-pointer">
              ฿ THB
            </button>
            <button type="button" data-curr="USD" class="curr-btn px-2.5 py-1 rounded-full text-[#94a3b8] hover:text-white transition-all cursor-pointer">
              $ USD
            </button>
            <button type="button" data-curr="CNY" class="curr-btn px-2.5 py-1 rounded-full text-[#94a3b8] hover:text-white transition-all cursor-pointer">
              ¥ CNY
            </button>
          </div>

          <!-- Language Toggle -->
          <div class="flex items-center bg-[#15151f] border border-[#2a2a3f] rounded-full p-0.5 text-xs font-mono" role="group" aria-label="Language selection">
            <button type="button" data-lang="en" class="lang-btn px-2.5 py-1 rounded-full text-[#94a3b8] hover:text-white transition-all cursor-pointer">
              EN
            </button>
            <button type="button" data-lang="th" class="lang-btn px-2.5 py-1 rounded-full bg-[#ff6b9d]/20 text-[#ff6b9d] font-bold border border-[#ff6b9d]/30 transition-all cursor-pointer">
              ไทย
            </button>
            <button type="button" data-lang="zh" class="lang-btn px-2.5 py-1 rounded-full text-[#94a3b8] hover:text-white transition-all cursor-pointer">
              中文
            </button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content Container -->
    <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 md:px-8 pt-8 space-y-14 relative z-10">

      <!-- Hero Section -->
      <section id="overview" class="relative bg-[#0d0d14] border border-[#1e1e2e] rounded-2xl p-6 sm:p-10 shadow-xl overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#15151f] border border-[#2a2a3f] text-xs font-mono tracking-wider text-[#5cceff]">
              <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
              <span data-i18n="heroBadge">Official Exchange Report · Spring 2026</span>
            </div>

            <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
              <span data-i18n="heroTitle">UC Berkeley Exchange</span><br />
              <span class="text-[#ff6b9d]" data-i18n="heroSubTitle">Academic & Complete Financial Ledger</span>
            </h1>

            <p class="text-sm sm:text-base text-[#94a3b8] leading-relaxed max-w-2xl" data-i18n="heroDescription">
              An exhaustive, 100% transparent financial report prepared for my family. Detailing my studies at UC Berkeley Extension (SCET Startup Semester), all 346 verified expenditures across 8 monthly Chase statements, and disciplined budgeting that came in below official I-20 limits.
            </p>

            <div class="pt-2 flex flex-wrap gap-2 text-xs font-mono">
              <div class="px-3 py-1.5 rounded-lg bg-[#15151f] border border-[#2a2a3f] text-[#cbd5e1] flex items-center gap-2">
                <span class="text-[#ffd700]">🎓</span> <span data-i18n="gpaBadge">GPA 4.000 / 4.000</span>
              </div>
              <div class="px-3 py-1.5 rounded-lg bg-[#15151f] border border-[#2a2a3f] text-[#cbd5e1] flex items-center gap-2">
                <span class="text-[#39ff14]">💰</span> <span data-i18n="budgetBadge">Under I-20 Budget (~66,550฿ Saved)</span>
              </div>
              <div class="px-3 py-1.5 rounded-lg bg-[#15151f] border border-[#2a2a3f] text-[#cbd5e1] flex items-center gap-2">
                <span class="text-[#5cceff]">🍳</span> <span data-i18n="foodBadge">Food: ~2,260฿ ($68) / Week</span>
              </div>
              <div class="px-3 py-1.5 rounded-lg bg-[#15151f] border border-[#2a2a3f] text-[#cbd5e1] flex items-center gap-2">
                <span class="text-[#ff6b9d]">📑</span> <span data-i18n="auditBadge">100% Math Reconciled to Cent</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 flex justify-center">
            <div class="relative group">
              <div class="w-64 sm:w-72 aspect-[4/5] rounded-2xl overflow-hidden border border-[#2a2a3f] bg-[#15151f] shadow-lg">
                <Image src={gateImg} alt="Bunyasit at Golden Gate Bridge, San Francisco" class="w-full h-full object-cover" width={600} height={750} />
              </div>
              <div class="absolute -bottom-3 -right-2 bg-[#15151f] border border-[#ff6b9d]/40 rounded-xl px-3 py-1.5 shadow-md flex items-center gap-2 text-xs font-mono text-white">
                <span>📍</span> Golden Gate Bridge, SF
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 1: Academic Achievement (The Family Pride) -->
      <section id="academics" class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-2.5 h-6 bg-[#ffd700] rounded-xs"></div>
          <h2 class="font-display text-2xl font-bold tracking-tight text-white" data-i18n="academicHeading">
            Academic Performance · ผลการเรียนยอดเยี่ยม · 学业成果
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch">
          <!-- GPA Hero Card -->
          <div class="md:col-span-4 bg-[#0d0d14] border border-[#ffd700]/40 rounded-2xl p-6 flex flex-col justify-between relative overflow-hidden">
            <div>
              <p class="font-mono text-xs text-[#ffd700] uppercase tracking-widest font-semibold" data-i18n="gpaCardLabel">Spring 2026 Semester</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="font-display text-5xl font-bold text-white">4.000</span>
                <span class="text-sm font-mono text-[#94a3b8]">/ 4.000</span>
              </div>
              <p class="text-xs text-[#10b981] font-mono mt-1 font-semibold flex items-center gap-1">
                <span>✓</span> <span data-i18n="gpaCardHonors">Straight-A Performance · Top Honors</span>
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-[#1e1e2e] space-y-2 text-xs font-mono text-[#94a3b8]">
              <div class="flex justify-between">
                <span data-i18n="totalUnitsLabel">Total Academic Units:</span>
                <span class="text-white font-bold">12 Units</span>
              </div>
              <div class="flex justify-between">
                <span data-i18n="programLabel">Program:</span>
                <span class="text-white font-bold">SCET Startup Semester</span>
              </div>
              <div class="flex justify-between">
                <span data-i18n="institutionLabel">Institution:</span>
                <span class="text-white font-bold">UC Berkeley Extension</span>
              </div>
            </div>
          </div>

          <!-- Course Grades Grid -->
          <div class="md:col-span-8 bg-[#0d0d14] border border-[#1e1e2e] rounded-2xl p-6 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs text-[#5cceff] uppercase tracking-widest font-semibold mb-4" data-i18n="courseListHeading">Course Grades & Units (Official CalCentral Record)</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="p-3.5 bg-[#15151f] border border-[#2a2a3f] rounded-xl flex items-center justify-between">
                  <div>
                    <p class="font-mono font-bold text-xs text-white">ENGIN 183D</p>
                    <p class="text-xs text-[#94a3b8] font-sans">Product Management (3 Units)</p>
                  </div>
                  <span class="px-2.5 py-1 bg-[#10b981]/20 text-[#10b981] border border-[#10b981]/40 rounded-md font-mono text-xs font-bold">A+</span>
                </div>

                <div class="p-3.5 bg-[#15151f] border border-[#2a2a3f] rounded-xl flex items-center justify-between">
                  <div>
                    <p class="font-mono font-bold text-xs text-white">ENGIN 183E</p>
                    <p class="text-xs text-[#94a3b8] font-sans">Tech Entrepreneurship (3 Units)</p>
                  </div>
                  <span class="px-2.5 py-1 bg-[#10b981]/20 text-[#10b981] border border-[#10b981]/40 rounded-md font-mono text-xs font-bold">A</span>
                </div>

                <div class="p-3.5 bg-[#15151f] border border-[#2a2a3f] rounded-xl flex items-center justify-between">
                  <div>
                    <p class="font-mono font-bold text-xs text-white">ENGIN 183C</p>
                    <p class="text-xs text-[#94a3b8] font-sans">Challenge Lab Startup (4 Units)</p>
                  </div>
                  <span class="px-2.5 py-1 bg-[#5cceff]/20 text-[#5cceff] border border-[#5cceff]/40 rounded-md font-mono text-xs font-bold">PASS</span>
                </div>

                <div class="p-3.5 bg-[#15151f] border border-[#2a2a3f] rounded-xl flex items-center justify-between">
                  <div>
                    <p class="font-mono font-bold text-xs text-white">ENGIN 183A / 198</p>
                    <p class="text-xs text-[#94a3b8] font-sans">Newton Lecture & Studies (2 Units)</p>
                  </div>
                  <span class="px-2.5 py-1 bg-[#5cceff]/20 text-[#5cceff] border border-[#5cceff]/40 rounded-md font-mono text-xs font-bold">PASS</span>
                </div>
              </div>
            </div>

            <p class="text-xs text-[#94a3b8] font-sans italic mt-4 pt-3 border-t border-[#1e1e2e]" data-i18n="academicNote">
              Official verification document: <span class="font-mono text-white">UC SR802F</span> & CalCentral Transcript dated May 2026.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 2: Complete Financial Breakdown ("All Money Shit Broken Down") -->
      <section id="breakdown" class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-2.5 h-6 bg-[#39ff14] rounded-xs"></div>
          <h2 class="font-display text-2xl font-bold tracking-tight text-white" data-i18n="financialOverviewHeading">
            Complete Financial Breakdown · แจกแจงค่าใช้จ่ายทุกหมวดหมู่ · 总体财务明细与决算
          </h2>
        </div>

        <!-- Budget vs Actual Cards -->
        <div class="bg-[#0d0d14] border border-[#1e1e2e] rounded-2xl p-6 md:p-8 space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="p-4 bg-[#15151f] border border-[#2a2a3f] rounded-xl">
              <p class="font-mono text-xs text-[#94a3b8] uppercase tracking-wider" data-i18n="i20BudgetLabel">Form I-20 Requirement</p>
              <p class="font-display text-2xl sm:text-3xl font-bold text-white mt-1" data-val-usd="27025" data-val-thb="898500" data-val-cny="193200">
                ฿898,500
              </p>
              <p class="text-xs text-[#94a3b8] mt-1 font-mono" data-i18n="i20BudgetSub">$15,775 Tuition + $11,250 Living</p>
            </div>

            <div class="p-4 bg-[#15151f] border border-[#39ff14]/40 rounded-xl">
              <p class="font-mono text-xs text-[#39ff14] uppercase tracking-wider font-semibold" data-i18n="actualTotalLabel">Actual All-In Expenditure</p>
              <p class="font-display text-2xl sm:text-3xl font-bold text-[#39ff14] mt-1" data-val-usd="25023.49" data-val-thb="832030" data-val-cny="178920">
                ฿832,030
              </p>
              <p class="text-xs text-[#39ff14]/80 mt-1 font-mono" data-i18n="actualTotalSub">Total Program Outflow ($25,023.49)</p>
            </div>

            <div class="p-4 bg-[#15151f] border border-[#ffd700]/40 rounded-xl">
              <p class="font-mono text-xs text-[#ffd700] uppercase tracking-wider font-semibold" data-i18n="savingsTotalLabel">Under Budget By</p>
              <p class="font-display text-2xl sm:text-3xl font-bold text-[#ffd700] mt-1" data-val-usd="2001.51" data-val-thb="66550" data-val-cny="14310">
                ฿66,550
              </p>
              <p class="text-xs text-[#ffd700]/80 mt-1 font-mono" data-i18n="savingsTotalSub">Disciplined budget savings ($2,001.51)</p>
            </div>
          </div>

          <!-- Visual Distribution Bar -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs font-mono text-[#94a3b8]">
              <span data-i18n="expenseBreakdownLabel">Major Expense Composition</span>
              <span class="text-white">100% Mathematically Reconciled</span>
            </div>
            <div class="w-full h-4 bg-[#15151f] rounded-full overflow-hidden flex border border-[#2a2a3f]">
              <div class="h-full bg-[#5cceff]" style="width: 46.0%;" title="Tuition: 46.0%"></div>
              <div class="h-full bg-[#ff6b9d]" style="width: 35.3%;" title="Housing: 35.3%"></div>
              <div class="h-full bg-[#39ff14]" style="width: 6.5%;" title="Food & Groceries: 6.5%"></div>
              <div class="h-full bg-[#ffd700]" style="width: 5.4%;" title="Travel & Ski: 5.4%"></div>
              <div class="h-full bg-[#a78bfa]" style="width: 6.8%;" title="Visa, Tech, Transit, Records: 6.8%"></div>
            </div>
            <div class="flex flex-wrap gap-4 text-xs font-mono pt-1 text-[#94a3b8]">
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#5cceff]"></span> <span data-i18n="legTuition">Tuition (46.0%)</span></span>
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#ff6b9d]"></span> <span data-i18n="legHousing">Housing & Rent (35.3%)</span></span>
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#39ff14]"></span> <span data-i18n="legFood">Food & Groceries (6.5%)</span></span>
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#ffd700]"></span> <span data-i18n="legTravel">Travel & Skiing (5.4%)</span></span>
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#a78bfa]"></span> <span data-i18n="legOther">Other Essentials (6.8%)</span></span>
            </div>
          </div>

          <!-- Comprehensive Category Breakdown Table -->
          <div class="overflow-x-auto pt-4">
            <table class="w-full text-left text-xs font-mono border-collapse">
              <thead>
                <tr class="border-b border-[#2a2a3f] text-[#94a3b8] uppercase tracking-wider">
                  <th class="py-3 px-3">Category</th>
                  <th class="py-3 px-3">Txs</th>
                  <th class="py-3 px-3">Share</th>
                  <th class="py-3 px-3 text-right">Amount</th>
                  <th class="py-3 px-3 hidden sm:table-cell">Key Highlights / Source</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#1e1e2e]">
                <tr class="hover:bg-[#15151f]/50 transition-colors">
                  <td class="py-3.5 px-3 flex items-center gap-2 font-bold text-white">
                    <span>🏛️</span> <span data-i18n="catTuitionName">UC Berkeley Tuition & Academics</span>
                  </td>
                  <td class="py-3.5 px-3 text-[#94a3b8]">7</td>
                  <td class="py-3.5 px-3 text-[#5cceff] font-bold">46.0%</td>
                  <td class="py-3.5 px-3 text-right font-bold text-white" data-val-usd="11503.60">฿382,490</td>
                  <td class="py-3.5 px-3 text-[#94a3b8] text-[11px] hidden sm:table-cell">Base tuition ($9,724), 2 Course Adds (2x$850), HBP cases, gym</td>
                </tr>

                <tr class="hover:bg-[#15151f]/50 transition-colors">
                  <td class="py-3.5 px-3 flex items-center gap-2 font-bold text-white">
                    <span>🏠</span> <span data-i18n="catHousingName">Apartment Rent & Utilities</span>
                  </td>
                  <td class="py-3.5 px-3 text-[#94a3b8]">34</td>
                  <td class="py-3.5 px-3 text-[#ff6b9d] font-bold">35.3%</td>
                  <td class="py-3.5 px-3 text-right font-bold text-white" data-val-usd="8826.18">฿293,470</td>
                  <td class="py-3.5 px-3 text-[#94a3b8] text-[11px] hidden sm:table-cell">2550 College Ave: Rent ($1,097.50/mo), PGE, water, Wi-Fi splits</td>
                </tr>

                <tr class="hover:bg-[#15151f]/50 transition-colors">
                  <td class="py-3.5 px-3 flex items-center gap-2 font-bold text-white">
                    <span>🍳</span> <span data-i18n="catFoodName">Food, Groceries & Amazon</span>
                  </td>
                  <td class="py-3.5 px-3 text-[#94a3b8]">110</td>
                  <td class="py-3.5 px-3 text-[#39ff14] font-bold">6.5%</td>
                  <td class="py-3.5 px-3 text-right font-bold text-[#39ff14]" data-val-usd="1632.35">฿54,280</td>
                  <td class="py-3.5 px-3 text-[#94a3b8] text-[11px] hidden sm:table-cell">Trader Joe's ($348), Amazon pantry ($428), local bites ($444), trips ($287)</td>
                </tr>

                <tr class="hover:bg-[#15151f]/50 transition-colors">
                  <td class="py-3.5 px-3 flex items-center gap-2 font-bold text-white">
                    <span>⛷️</span> <span data-i18n="catTravelName">Travel, Skiing & Yosemite</span>
                  </td>
                  <td class="py-3.5 px-3 text-[#94a3b8]">7</td>
                  <td class="py-3.5 px-3 text-[#ffd700] font-bold">5.4%</td>
                  <td class="py-3.5 px-3 text-right font-bold text-white" data-val-usd="1341.85">฿44,620</td>
                  <td class="py-3.5 px-3 text-[#94a3b8] text-[11px] hidden sm:table-cell">Sugar Bowl Tahoe ski passes ($886), Yosemite Curry Village ($364)</td>
                </tr>

                <tr class="hover:bg-[#15151f]/50 transition-colors">
                  <td class="py-3.5 px-3 flex items-center gap-2 font-bold text-white">
                    <span>🛂</span> <span data-i18n="catVisaName">US Visa & SEVIS I-901</span>
                  </td>
                  <td class="py-3.5 px-3 text-[#94a3b8]">2</td>
                  <td class="py-3.5 px-3 text-[#a78bfa] font-bold">2.1%</td>
                  <td class="py-3.5 px-3 text-right font-bold text-white" data-val-usd="535.00">฿17,790</td>
                  <td class="py-3.5 px-3 text-[#94a3b8] text-[11px] hidden sm:table-cell">SEVIS fee ($350) + US Embassy Bangkok MRV appointment ($185)</td>
                </tr>

                <tr class="hover:bg-[#15151f]/50 transition-colors">
                  <td class="py-3.5 px-3 flex items-center gap-2 font-bold text-white">
                    <span>💻</span> <span data-i18n="catTechName">Tech, AI & Cloud Tools</span>
                  </td>
                  <td class="py-3.5 px-3 text-[#94a3b8]">17</td>
                  <td class="py-3.5 px-3 text-[#a78bfa] font-bold">2.0%</td>
                  <td class="py-3.5 px-3 text-right font-bold text-white" data-val-usd="507.47">฿16,870</td>
                  <td class="py-3.5 px-3 text-[#94a3b8] text-[11px] hidden sm:table-cell">NVIDIA GTC ($30), Vercel ($100), Fireworks AI ($61), ElevenLabs ($44)</td>
                </tr>

                <tr class="hover:bg-[#15151f]/50 transition-colors">
                  <td class="py-3.5 px-3 flex items-center gap-2 font-bold text-white">
                    <span>🎵</span> <span data-i18n="catThriftName">Vinyl, Thrift & Books</span>
                  </td>
                  <td class="py-3.5 px-3 text-[#94a3b8]">16</td>
                  <td class="py-3.5 px-3 text-[#a78bfa] font-bold">1.5%</td>
                  <td class="py-3.5 px-3 text-right font-bold text-white" data-val-usd="380.41">฿12,650</td>
                  <td class="py-3.5 px-3 text-[#94a3b8] text-[11px] hidden sm:table-cell">Amoeba Records ($108), Rasputin ($52), Goodwill/Ross ($131), books</td>
                </tr>

