    function formatAmount(usd, showSign = false) {
      const isPositive = usd > 0;
      const absUsd = Math.abs(usd);
      let formatted = '';
      if (currentCurr === 'THB') {
        const thb = Math.round(absUsd * FX_RATES.THB);
        formatted = '฿' + thb.toLocaleString();
      } else if (currentCurr === 'USD') {
        formatted = '$' + absUsd.toLocaleString(undefined, { minimumFractionDigits: absUsd % 1 === 0 ? 0 : 2, maximumFractionDigits: 2 });
      } else if (currentCurr === 'CNY') {
        const cny = Math.round(absUsd * FX_RATES.CNY);
        formatted = '¥' + cny.toLocaleString();
      }

      if (showSign) {
        return (isPositive ? '+ ' : '- ') + formatted;
      }
      return formatted;
    }

    function updateCurrency(curr) {
      currentCurr = curr;

      // Update currency buttons active state
      document.querySelectorAll('.curr-btn').forEach(btn => {
        if (btn.getAttribute('data-curr') === curr) {
          btn.className = 'curr-btn px-2.5 py-1 rounded-full bg-[#39ff14]/20 text-[#39ff14] font-bold border border-[#39ff14]/30 transition-all cursor-pointer';
        } else {
          btn.className = 'curr-btn px-2.5 py-1 rounded-full text-[#94a3b8] hover:text-white transition-all cursor-pointer';
        }
      });

      // Update static data-val-usd elements
      document.querySelectorAll('[data-val-usd]').forEach(el => {
        const usd = parseFloat(el.getAttribute('data-val-usd'));
        el.textContent = formatAmount(usd);
      });

      // Update simulator cost tags
      document.querySelectorAll('[data-sim-cost]').forEach(el => {
        const key = el.getAttribute('data-sim-cost');
        if (SIM_DATA[key] && SIM_DATA[key].weekly[curr]) {
          el.textContent = SIM_DATA[key].weekly[curr];
        }
      });

      // Refresh currently selected simulator
      const activeSimBtn = document.querySelector('.sim-btn.active');
      if (activeSimBtn) {
        renderSim(activeSimBtn.getAttribute('data-sim'));
      }

      // Re-render transaction table with new currency
      renderLedger();
    }

    function updateLanguage(lang) {
      currentLang = lang;

      // Update language buttons active state
      document.querySelectorAll('.lang-btn').forEach(btn => {
        if (btn.getAttribute('data-lang') === lang) {
          btn.className = 'lang-btn px-2.5 py-1 rounded-full bg-[#ff6b9d]/20 text-[#ff6b9d] font-bold border border-[#ff6b9d]/30 transition-all cursor-pointer';
        } else {
          btn.className = 'lang-btn px-2.5 py-1 rounded-full text-[#94a3b8] hover:text-white transition-all cursor-pointer';
        }
      });

      // Update i18n text nodes
      const dict = I18N_DICT[lang] || I18N_DICT.en;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) {
          el.textContent = dict[key];
        }
      });

      // Toggle language letter paragraphs
      document.querySelectorAll('.lang-text').forEach(el => {
        if (el.classList.contains('lang-' + lang)) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Refresh simulator text
      const activeSimBtn = document.querySelector('.sim-btn.active');
      if (activeSimBtn) {
        renderSim(activeSimBtn.getAttribute('data-sim'));
      }
    }

    function renderSim(key) {
      const data = SIM_DATA[key];
      if (!data) return;

      const titleEl = document.getElementById('sim-title');
      const weeklyEl = document.getElementById('sim-weekly-val');
      const semesterEl = document.getElementById('sim-semester-val');
      const descEl = document.getElementById('sim-desc');
      const savingsEl = document.getElementById('sim-savings');

      if (titleEl) titleEl.textContent = data.title[currentLang] || data.title.en;
      if (weeklyEl) weeklyEl.textContent = data.weekly[currentCurr] || data.weekly.THB;
      if (semesterEl) semesterEl.textContent = '(' + (data.total[currentCurr] || data.total.THB) + ')';
      if (descEl) descEl.textContent = data.desc[currentLang] || data.desc.en;
      if (savingsEl) savingsEl.textContent = data.savings[currentLang] || data.savings.en;
    }

    // Ledger Filter & Render Engine
    function filterTransactions() {
      const q = searchQuery.trim().toLowerCase();

      return allTransactions.filter(t => {
        // Category filter
        if (activeCat !== 'all' && t.category !== activeCat) {
          return false;
        }

        // Flow filter
        if (activeFlow === 'debit' && t.amount >= 0) return false;
        if (activeFlow === 'credit' && t.amount <= 0) return false;

        // Search text filter
        if (q) {
          const matchDesc = (t.desc || '').toLowerCase().includes(q);
          const matchRaw = (t.raw_desc || '').toLowerCase().includes(q);
          const matchCat = (t.cat_name || '').toLowerCase().includes(q);
          const matchSub = (t.subcat || '').toLowerCase().includes(q);
          const matchSrc = (t.source || '').toLowerCase().includes(q);
          const matchDate = (t.date || '').toLowerCase().includes(q);
          if (!matchDesc && !matchRaw && !matchCat && !matchSub && !matchSrc && !matchDate) {
            return false;
          }
        }

        return true;
      }).sort((a, b) => {
        if (sortField === 'date') {
          return sortAsc ? a.date.localeCompare(b.date) : b.date.localeCompare(a.date);
        } else if (sortField === 'amount') {
          return sortAsc ? a.amount - b.amount : b.amount - a.amount;
        }
        return 0;
      });
    }

    function renderLedger() {
      const filtered = filterTransactions();
      const totalCount = filtered.length;
      const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // Calculate filtered sum
      const sum = filtered.reduce((acc, t) => acc + t.amount, 0);

      // Update counters
      const showingEl = document.getElementById('tx-showing-count');
      const sumEl = document.getElementById('tx-filtered-sum');
      const pageInfoEl = document.getElementById('tx-page-info');
      const prevBtn = document.getElementById('tx-prev-btn');
      const nextBtn = document.getElementById('tx-next-btn');

      if (showingEl) showingEl.textContent = totalCount.toLocaleString();
      if (sumEl) {
        sumEl.textContent = formatAmount(sum, true);
        if (sum >= 0) {
          sumEl.className = 'text-[#39ff14] font-bold text-sm';
        } else {
          sumEl.className = 'text-white font-bold text-sm';
        }
      }

      if (pageInfoEl) pageInfoEl.textContent = `Page ${currentPage} of ${totalPages} (${totalCount} results)`;
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

      // Slice current page
      const startIdx = (currentPage - 1) * pageSize;
      const pageItems = filtered.slice(startIdx, startIdx + pageSize);

      const tbody = document.getElementById('tx-table-body');
      if (!tbody) return;

      if (pageItems.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="py-8 text-center text-[#94a3b8] font-sans">
              No transactions found matching your search. Try clearing filters.
            </td>
          </tr>
        `;
        return;
      }

      const rowsHtml = pageItems.map(t => {
        const isCredit = t.amount > 0;
        const amtColor = isCredit ? 'text-[#39ff14]' : 'text-white';
        const formattedAmt = formatAmount(t.amount, true);

        // Category badge color
        let catBadgeColor = 'bg-[#15151f] text-[#94a3b8] border-[#2a2a3f]';
        if (t.category === 'tuition') catBadgeColor = 'bg-[#5cceff]/15 text-[#5cceff] border-[#5cceff]/30';
        else if (t.category === 'housing') catBadgeColor = 'bg-[#ff6b9d]/15 text-[#ff6b9d] border-[#ff6b9d]/30';
        else if (t.category === 'food') catBadgeColor = 'bg-[#39ff14]/15 text-[#39ff14] border-[#39ff14]/30';
        else if (t.category === 'travel') catBadgeColor = 'bg-[#ffd700]/15 text-[#ffd700] border-[#ffd700]/30';
        else if (t.category === 'inflow') catBadgeColor = 'bg-[#39ff14]/20 text-[#39ff14] border-[#39ff14]/40 font-bold';
        else if (t.category === 'tech') catBadgeColor = 'bg-[#a78bfa]/15 text-[#a78bfa] border-[#a78bfa]/30';

        return `
          <tr class="hover:bg-[#15151f]/70 transition-colors">
            <td class="py-3 px-3 text-[#94a3b8] whitespace-nowrap text-[11px] font-mono">${t.date}</td>
            <td class="py-3 px-3">
              <div class="font-sans font-medium text-white text-xs">${t.desc}</div>
              <div class="text-[10px] text-[#6b7280] font-mono truncate max-w-xs sm:max-w-md">${t.raw_desc || ''}</div>
              <div class="sm:hidden mt-1 flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded-sm border text-[9px] font-mono ${catBadgeColor}">${t.cat_name}</span>
                <span class="text-[9px] text-[#6b7280] truncate font-mono">${t.source}</span>
              </div>
            </td>
            <td class="py-3 px-3 hidden sm:table-cell">
              <span class="px-2 py-0.5 rounded-md border text-[10px] whitespace-nowrap font-mono ${catBadgeColor}">${t.cat_name}</span>
            </td>
            <td class="py-3 px-3 hidden md:table-cell text-[#94a3b8] text-[11px] whitespace-nowrap">${t.source}</td>
            <td class="py-3 px-3 text-right font-bold whitespace-nowrap font-mono ${amtColor}">${formattedAmt}</td>
          </tr>
        `;
      }).join('');

      tbody.innerHTML = rowsHtml;
    }

    // Attach Event Listeners on DOM Ready
    document.addEventListener('DOMContentLoaded', () => {
      // Currency buttons
      document.querySelectorAll('.curr-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          updateCurrency(btn.getAttribute('data-curr'));
        });
      });

      // Language buttons
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          updateLanguage(btn.getAttribute('data-lang'));
        });
      });

      // Simulator buttons
      document.querySelectorAll('.sim-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.sim-btn').forEach(b => {
            b.classList.remove('active', 'bg-[#39ff14]/20', 'text-[#39ff14]', 'border-[#39ff14]/40');
            b.classList.add('bg-[#0d0d14]', 'text-[#94a3b8]', 'border-[#2a2a3f]');
          });
          btn.classList.add('active', 'bg-[#39ff14]/20', 'text-[#39ff14]', 'border-[#39ff14]/40');
          btn.classList.remove('bg-[#0d0d14]', 'text-[#94a3b8]', 'border-[#2a2a3f]');
          renderSim(btn.getAttribute('data-sim'));
        });
      });

      // Ledger: Category Filter Pills
      document.querySelectorAll('.cat-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cat-pill').forEach(b => {
            b.className = 'cat-pill px-3 py-1 rounded-lg bg-[#15151f] text-[#94a3b8] border border-[#2a2a3f] hover:border-white cursor-pointer';
          });
          btn.className = 'cat-pill active px-3 py-1 rounded-lg bg-[#5cceff]/20 text-[#5cceff] font-bold border border-[#5cceff]/40 cursor-pointer';
          activeCat = btn.getAttribute('data-cat');
          currentPage = 1;
          renderLedger();
        });
      });

      // Ledger: Flow Filter Buttons
      document.querySelectorAll('.flow-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.flow-btn').forEach(b => {
            b.className = 'flow-btn px-3 py-1 rounded-lg text-[#94a3b8] hover:text-white cursor-pointer';
          });
          btn.className = 'flow-btn px-3 py-1 rounded-lg bg-[#39ff14]/20 text-[#39ff14] font-bold border border-[#39ff14]/30 cursor-pointer';
          activeFlow = btn.getAttribute('data-flow');
          currentPage = 1;
          renderLedger();
        });
      });

      // Ledger: Search Input
      const searchInput = document.getElementById('tx-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value;
          currentPage = 1;
          renderLedger();
        });
      }

      // Ledger: Pagination Controls
      const prevBtn = document.getElementById('tx-prev-btn');
      const nextBtn = document.getElementById('tx-next-btn');

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderLedger();
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentPage++;
          renderLedger();
        });
      }

      // Ledger: Sort headers
      const thDate = document.getElementById('th-date');
      const thAmount = document.getElementById('th-amount');

      if (thDate) {
        thDate.addEventListener('click', () => {
          if (sortField === 'date') {
            sortAsc = !sortAsc;
          } else {
            sortField = 'date';
            sortAsc = false;
          }
          thDate.textContent = `Date ${sortAsc ? '▲' : '▼'}`;
          if (thAmount) thAmount.textContent = 'Amount';
          renderLedger();
        });
      }

      if (thAmount) {
        thAmount.addEventListener('click', () => {
          if (sortField === 'amount') {
            sortAsc = !sortAsc;
          } else {
            sortField = 'amount';
            sortAsc = true;
          }
          thAmount.textContent = `Amount ${sortAsc ? '▲' : '▼'}`;
          if (thDate) thDate.textContent = 'Date';
          renderLedger();
        });
      }

      // Set initial defaults: Thai language & THB currency
      updateLanguage('th');
      updateCurrency('THB');
      renderLedger();
    });
  })();
</script>

