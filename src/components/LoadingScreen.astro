---
// Netflix-style cinematic intro for bigf.me
// Pure CSS animation - no external assets
---

<div id="intro-overlay" class="intro-overlay" aria-hidden="true">
  <div class="intro-stage">
    <!-- Netflix-style expanding arc logo -->
    <div class="netflix-logo">
      <div class="ribbon ribbon-left"></div>
      <div class="ribbon ribbon-center"></div>
      <div class="ribbon ribbon-right"></div>
      <!-- Light sweep effect -->
      <div class="light-sweep"></div>
    </div>
    
    <!-- Site name -->
    <div class="intro-brand">
      <span class="brand-text">bigf.me</span>
    </div>
  </div>
  
  <!-- Skip hint -->
  <div class="skip-hint">
    <span class="skip-text">Click or tap to skip</span>
  </div>
</div>

<style>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.8s;
  }

  .intro-overlay.intro--done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .intro-overlay.intro--hidden {
    display: none;
  }

  .intro-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  /* Netflix-style logo container */
  .netflix-logo {
    position: relative;
    width: 120px;
    height: 180px;
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  /* The three ribbon arcs */
  .ribbon {
    position: absolute;
    top: 0;
    width: 40px;
    height: 100%;
    transform-origin: center;
    opacity: 0;
    border-radius: 2px;
  }

  .ribbon-left {
    left: 0;
    background: linear-gradient(180deg, 
      #b20710 0%, 
      #e50914 40%, 
      #ff0a16 60%, 
      #b20710 100%
    );
    transform: perspective(1000px) rotateY(-25deg) scaleX(0);
    box-shadow: 
      -5px 0 20px rgba(229, 9, 20, 0.4),
      inset -3px 0 10px rgba(0,0,0,0.3);
    animation: arcExpandLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  .ribbon-center {
    left: 50%;
    transform: translateX(-50%) perspective(1000px) rotateY(0deg) scaleX(0);
    background: linear-gradient(180deg, 
      #e50914 0%, 
      #ff0a16 30%, 
      #ff4d54 50%, 
      #ff0a16 70%, 
      #e50914 100%
    );
    box-shadow: 
      0 0 30px rgba(255, 10, 22, 0.5),
      0 0 60px rgba(229, 9, 20, 0.3),
      inset 0 0 20px rgba(255, 100, 100, 0.2);
    z-index: 2;
    animation: arcExpandCenter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  .ribbon-right {
    right: 0;
    background: linear-gradient(180deg, 
      #b20710 0%, 
      #e50914 40%, 
      #ff0a16 60%, 
      #b20710 100%
    );
    transform: perspective(1000px) rotateY(25deg) scaleX(0);
    box-shadow: 
      5px 0 20px rgba(229, 9, 20, 0.4),
      inset 3px 0 10px rgba(0,0,0,0.3);
    animation: arcExpandRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
  }

  /* Curved arc effect using clip-path */
  .ribbon-left {
    clip-path: polygon(
      0% 0%, 
      100% 5%, 
      100% 95%, 
      0% 100%
    );
  }

  .ribbon-center {
    clip-path: polygon(
      0% 3%, 
      100% 0%, 
      100% 100%, 
      0% 97%
    );
  }

  .ribbon-right {
    clip-path: polygon(
      0% 5%, 
      100% 0%, 
      100% 100%, 
      0% 95%
    );
  }

  /* Light sweep that travels across the ribbons */
  .light-sweep {
    position: absolute;
    top: -20%;
    left: -50%;
    width: 30%;
    height: 140%;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(255, 200, 200, 0.1) 20%,
      rgba(255, 255, 255, 0.4) 50%,
      rgba(255, 200, 200, 0.1) 80%,
      transparent 100%
    );
    filter: blur(8px);
    transform: skewX(-15deg);
    opacity: 0;
    animation: sweepLight 0.6s ease-out 1.1s forwards;
    pointer-events: none;
    z-index: 3;
  }

  /* Brand text */
  .intro-brand {
    opacity: 0;
    transform: translateY(10px);
    animation: brandReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.4s forwards;
  }

  .brand-text {
    font-family: 'Funnel Display', 'Bebas Neue', Impact, 'Arial Black', sans-serif;
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #ffffff;
    text-transform: lowercase;
    text-shadow: 
      0 0 10px rgba(255, 255, 255, 0.3),
      0 0 40px rgba(229, 9, 20, 0.2);
  }

  /* Skip hint */
  .skip-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: skipHintIn 0.3s ease 0.5s forwards;
    cursor: pointer;
    z-index: 10001;
  }

  .skip-text {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .skip-hint:hover .skip-text {
    color: rgba(255, 255, 255, 0.6);
  }

  /* ===== KEYFRAMES ===== */

  @keyframes arcExpandLeft {
    0% {
      opacity: 0;
      transform: perspective(1000px) rotateY(-45deg) scaleX(0);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: perspective(1000px) rotateY(-25deg) scaleX(1);
    }
  }

  @keyframes arcExpandCenter {
    0% {
      opacity: 0;
      transform: translateX(-50%) perspective(1000px) rotateY(0deg) scaleX(0);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) perspective(1000px) rotateY(0deg) scaleX(1);
    }
  }

  @keyframes arcExpandRight {
    0% {
      opacity: 0;
      transform: perspective(1000px) rotateY(45deg) scaleX(0);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: perspective(1000px) rotateY(25deg) scaleX(1);
    }
  }

  @keyframes sweepLight {
    0% {
      opacity: 0;
      left: -50%;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      left: 120%;
    }
  }

  @keyframes brandReveal {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes skipHintIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  /* Exit animation classes */
  .intro-overlay.intro--exiting {
    animation: introExit 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes introExit {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .intro-overlay {
      display: none !important;
    }
  }
</style>

<script>
  (function() {
    const STORAGE_KEY = 'bigf-intro-seen';
    const OVERLAY_ID = 'intro-overlay';
    const SKIP_DELAY = 300; // ms before skip is allowed
    const AUTO_SKIP_DELAY = 2200; // ms before auto-fade
    
    const overlay = document.getElementById(OVERLAY_ID);
    if (!overlay) return;

    // Check if user has seen intro recently (within 24 hours)
    const lastSeen = localStorage.getItem(STORAGE_KEY);
    const now = Date.now();
    const ONE_DAY = 24 * 60 * 60 * 1000;
    
    if (lastSeen && (now - parseInt(lastSeen)) < ONE_DAY) {
      // Already seen, hide immediately
      overlay.classList.add('intro--hidden');
      return;
    }

    // Temporarily hide custom cursor while intro plays
    const cursorDot = document.getElementById('cursor-dot');
    const cursorOutline = document.getElementById('cursor-outline');
    if (cursorDot) cursorDot.style.opacity = '0';
    if (cursorOutline) cursorOutline.style.opacity = '0';

    let skipEnabled = false;
    let exited = false;

    function exitIntro() {
      if (exited) return;
      exited = true;
      
      // Mark as seen
      localStorage.setItem(STORAGE_KEY, now.toString());
      
      // Fade out
      overlay.classList.add('intro--exiting');
      
      // Restore cursor
      setTimeout(() => {
        if (cursorDot) cursorDot.style.opacity = '1';
        if (cursorOutline) cursorOutline.style.opacity = '1';
      }, 400);
      
      // Fully hide after transition
      setTimeout(() => {
        overlay.classList.add('intro--hidden');
      }, 800);
    }

    // Enable skip after initial delay
    setTimeout(() => {
      skipEnabled = true;
    }, SKIP_DELAY);

    // Auto-exit after full animation
    const autoExitTimer = setTimeout(() => {
      exitIntro();
    }, AUTO_SKIP_DELAY);

    // Click/tap to skip
    overlay.addEventListener('click', (e) => {
      if (!skipEnabled || exited) return;
      clearTimeout(autoExitTimer);
      exitIntro();
    });

    overlay.addEventListener('touchstart', (e) => {
      if (!skipEnabled || exited) return;
      clearTimeout(autoExitTimer);
      exitIntro();
    }, { passive: true });

    // Keyboard skip
    overlay.addEventListener('keydown', (e) => {
      if (!skipEnabled || exited) return;
      if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        clearTimeout(autoExitTimer);
        exitIntro();
      }
    });

    // Make overlay focusable for keyboard access
    overlay.setAttribute('tabindex', '-1');
    overlay.focus();
  })();
</script>
