---
---

<div class="w-full h-full flex flex-col items-center justify-center bg-[#0a0a0f] text-[#e2e8f0] overflow-hidden">
  
  <!-- Minimalist Open Journal Page - Dark Synthwave Variant -->
  <div class="relative w-[90vw] max-w-[380px] h-[608px] bg-[#1a1a24] rounded-[2rem] shadow-[0_20px_40px_rgba(0,0,0,0.5),_0_0_0_1px_rgba(255,255,255,0.05)] flex flex-col p-8 border border-[#2a2a3f] relative group hover:scale-[1.01] transition-transform duration-500">
    
    <!-- Neon Dotted Grid Pattern -->
    <div class="absolute inset-0 opacity-[0.15] pointer-events-none rounded-[2rem]" style="background-image: radial-gradient(#ff6b9d 1px, transparent 1px); background-size: 16px 16px;"></div>
    
    <!-- Neon Synth Pink notebook margin line on the left -->
    <div class="absolute top-0 bottom-0 left-12 w-[1px] bg-[#ff6b9d]/30"></div>
    
    <!-- Content Layer -->
    <div class="relative w-full h-full flex flex-col z-10 text-[#e2e8f0] font-sans">
      
      <!-- Top Meta -->
      <div class="flex items-center justify-between text-xs tracking-[0.15em] text-[#8a8899] uppercase font-mono font-medium mb-6 pl-6">
        <span>Thoughts</span>
        <span>No. 02</span>
      </div>

      <!-- Journal Title -->
      <div class="pl-6 mb-8">
        <h1 class="font-serif text-3xl italic tracking-wide font-black text-white mb-1">Analog Pages</h1>
        <div class="text-xs uppercase tracking-wide text-[#ff6b9d] font-semibold">Reading & Ideas</div>
      </div>
      
      <!-- Main Content / Lines -->
      <div class="flex-1 pl-6 flex flex-col justify-between font-serif text-sm leading-[2rem] text-[#b4b2c5]">
        
        <div class="space-y-4">
          <p class="border-b border-[#2a2a3f]/75 pb-1">
            <span class="font-sans text-xs uppercase font-bold tracking-wide text-[#ff6b9d] mr-2">Focus</span>
            "Deep Work is the only kind of work that yields real craft."
          </p>
          
          <p class="border-b border-[#2a2a3f]/75 pb-1">
            <span class="font-sans text-xs uppercase font-bold tracking-wide text-[#00d4ff] mr-2">Mind</span>
            "Own your shadow completely, or it will own you."
          </p>
          
          <p class="border-b border-[#2a2a3f]/75 pb-1">
            <span class="font-sans text-xs uppercase font-bold tracking-wide text-[#ffb86c] mr-2">Monopoly</span>
            "Go from Zero to One. Build unique secrets, don't copy."
          </p>
        </div>

        <!-- Curated Book List -->
        <div class="mt-8 font-sans text-sm text-[#8a8899] space-y-2 leading-relaxed">
          <div class="text-xs uppercase tracking-[0.15em] font-bold text-[#ff6b9d] mb-2">Curated Readings</div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-[#ff6b9d] rounded-full"></span>
            <span>Philosophy of Software Design (Ousterhout)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-[#ff6b9d] rounded-full"></span>
            <span>Digital Minimalism (Cal Newport)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-[#ff6b9d] rounded-full"></span>
            <span>White Nights (Fyodor Dostoevsky)</span>
          </div>
        </div>

      </div>

      <!-- Bottom Stamp/Footer -->
      <div class="mt-8 pt-4 border-t border-[#2a2a3f] pl-6 flex items-center justify-between text-xs uppercase tracking-wide text-[#8a8899] font-semibold">
        <span>B6 Slim Form</span>
        <span>© 2026</span>
      </div>

    </div>
  </div>

  <div class="absolute bottom-6 text-[#8a8899] text-xs font-sans tracking-[0.2em] uppercase">
    Minimalist Journal Page
  </div>

</div>
