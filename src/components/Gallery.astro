---
import { db } from '../lib/db';

// Fetch all photos from the database sorted by created_at desc
let photos = [];
try {
  const result = await db.execute({
    sql: `SELECT * FROM photos ORDER BY created_at DESC`,
    args: [],
  });
  photos = result.rows;
} catch (e) {
  console.error("Failed to fetch photos from DB:", e);
}

const defaultJournalPages = [
  {
    isMock: true,
    type: 'notebook',
    tag: '#roasting',
    title: 'SF Coffee Roasts',
    url: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=600&auto=format&fit=crop',
    created_at: 'April 25, 2026',
    location: 'SF / Berkeley'
  },
  {
    isMock: true,
    type: 'notes',
    tag: '#startup',
    title: 'SCET Berkeley Notes',
    url: 'https://images.unsplash.com/photo-1517842645767-c639042777db?q=80&w=600&auto=format&fit=crop',
    created_at: 'April 18, 2026',
    location: 'California'
  },
  {
    isMock: true,
    type: 'hardware',
    tag: '#hardware',
    title: 'Ergo Layout Design',
    url: 'https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?q=80&w=600&auto=format&fit=crop',
    created_at: 'March 12, 2026',
    location: 'LongKeeb Lab'
  },
  {
    isMock: true,
    type: 'random',
    tag: '#koji',
    title: 'Fermentation IoT',
    url: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?q=80&w=600&auto=format&fit=crop',
    created_at: 'Feb 05, 2026',
    location: 'Bangkok'
  }
];

// Merge DB photos first so they appear at the top, followed by curated defaults
const allPages = [...photos, ...defaultJournalPages];

const formatDate = (dateStr) => {
  if (!dateStr) return 'Recent';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch {
    return 'Recent';
  }
};
---

<div class="w-full h-full flex flex-col items-center justify-center bg-[#0a0a0f] text-[#e2e8f0] overflow-hidden">
  
  <!-- Open Binder Sheet Spread - Dark Synthwave Variant -->
  <div class="relative w-[90vw] max-w-4xl h-[70vh] bg-[#161622] rounded-[2rem] shadow-[0_30px_60px_rgba(0,0,0,0.6),_0_0_0_1px_rgba(255,255,255,0.05)] flex flex-col p-10 border border-[#2a2a3f] group hover:scale-[1.005] transition-transform duration-500">
    
    <!-- Left Margin / Crease Line -->
    <div class="absolute top-0 bottom-0 left-[4.5rem] w-[1px] bg-[#2a2a3f]"></div>
    
    <!-- 4 Binder Punch Holes (Left Spine style) -->
    <div class="absolute left-6 top-0 bottom-0 flex flex-col justify-around py-16 z-20 pointer-events-none">
      <div class="w-3.5 h-3.5 bg-[#0a0a0f] rounded-full border border-[#2a2a3f] shadow-[inset_1px_1px_3px_rgba(0,0,0,0.8)] flex items-center justify-center">
        <div class="w-1.5 h-1.5 bg-[#1a1a24] rounded-full"></div>
      </div>
      <div class="w-3.5 h-3.5 bg-[#0a0a0f] rounded-full border border-[#2a2a3f] shadow-[inset_1px_1px_3px_rgba(0,0,0,0.8)] flex items-center justify-center">
        <div class="w-1.5 h-1.5 bg-[#1a1a24] rounded-full"></div>
      </div>
      <div class="w-3.5 h-3.5 bg-[#0a0a0f] rounded-full border border-[#2a2a3f] shadow-[inset_1px_1px_3px_rgba(0,0,0,0.8)] flex items-center justify-center">
        <div class="w-1.5 h-1.5 bg-[#1a1a24] rounded-full"></div>
      </div>
      <div class="w-3.5 h-3.5 bg-[#0a0a0f] rounded-full border border-[#2a2a3f] shadow-[inset_1px_1px_3px_rgba(0,0,0,0.8)] flex items-center justify-center">
        <div class="w-1.5 h-1.5 bg-[#1a1a24] rounded-full"></div>
      </div>
    </div>

    <!-- Binder Content Spread -->
    <div class="flex-1 w-full h-full flex flex-col pl-16 z-10 text-[#e2e8f0] overflow-hidden font-sans">
      
      <!-- Header -->
      <div class="flex items-center justify-between border-b border-[#2a2a3f] pb-4 mb-6 font-mono flex-wrap gap-2">
        <div>
          <h1 class="font-serif text-3xl font-black tracking-wide text-white flex items-center gap-2">
            <span>Journal Captures</span>
            <span class="text-lg opacity-85">📁</span>
          </h1>
          <p class="text-xs uppercase tracking-[0.15em] text-[#ff6b9d] font-semibold mt-1">Workspace 03 : Minimal Binder Spread</p>
        </div>
        <div class="text-xs uppercase font-mono tracking-wide text-[#8a8899] border border-[#2a2a3f] px-3 py-1 rounded-full bg-[#161622] shadow-inner shrink-0">
          pages count: {allPages.length.toString().padStart(2, '0')}
        </div>
      </div>

      <!-- Journal Grid -->
      <div class="flex-1 grid grid-cols-2 gap-6 overflow-y-auto overflow-x-hidden pr-2 custom-scrollbar min-w-0">
        {allPages.map((page, index) => {
          const isDb = !page.isMock;
          const imageUrl = page.url;
          const title = isDb ? `Scanned ${page.type || 'page'}` : page.title;
          const tag = isDb ? `#${page.type || 'capture'}` : page.tag;
          const dateText = isDb ? formatDate(page.created_at) : page.created_at;
          const locationText = isDb ? 'Journal Upload' : page.location;

          return (
            <div
              class="flex flex-col bg-[#11111a] border border-[#2a2a3f]/70 rounded-xl p-4 shadow-md hover:shadow-[0_0_20px_rgba(255,107,157,0.15)] hover:border-[#ff6b9d]/60 transition-all duration-300 group/card relative overflow-hidden cursor-pointer journal-card min-w-0"
              data-url={imageUrl}
              data-title={title}
              data-tag={tag}
              data-date={dateText}
              data-location={locationText}
            >
              <div class="w-full aspect-[4/3] bg-[#0a0a0f] border border-[#2a2a3f] rounded-lg mb-3 flex items-center justify-center relative overflow-hidden">
                {imageUrl ? (
                  <img src={imageUrl} alt={title} class="w-full h-full object-cover rounded-lg shadow-inner group-hover/card:scale-105 transition-transform duration-500 filter brightness-90 contrast-105" />
                ) : (
                  <div class="absolute inset-0 opacity-[0.1]" style="background-image: linear-gradient(#ff6b9d 1px, transparent 1px); background-size: 8px 8px;"></div>
                )}
                <span class="absolute top-2 right-2 text-xs font-mono tracking-wide uppercase text-[#8a8899] bg-[#161622]/90 backdrop-blur-sm px-2 py-0.5 rounded border border-[#2a2a3f] z-10 shadow-sm">
                  {isDb ? 'DB Photo' : `Page 0${index + 1}`}
                </span>
              </div>
              <div class="flex-1 flex flex-col justify-between min-w-0">
                <div class="min-w-0">
                  <div class={`text-xs font-mono uppercase tracking-wide mb-1 font-bold truncate ${isDb ? 'text-[#00d4ff]' : 'text-[#ff6b9d]'}`}>
                    {tag}
                  </div>
                  <h2 class="font-serif text-base italic text-white leading-tight mb-2 truncate">{title}</h2>
                </div>
                <div class="text-xs font-mono text-[#8a8899] flex justify-between border-t border-[#2a2a3f] pt-2 mt-2">
                  <span class="truncate">{dateText}</span>
                  <span class="truncate">{locationText}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Bottom Stamp/Footer -->
      <div class="mt-4 pt-4 border-t border-[#2a2a3f] flex items-center justify-between text-xs uppercase tracking-wide text-[#8a8899] font-semibold font-mono">
        <span>Dark Binder Spread</span>
        <span>© 2026 Bunyasit Fang</span>
      </div>

    </div>
  </div>

  <!-- Fullscreen Lightbox Modal -->
  <div id="lightbox-modal" class="hidden fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[#0a0a0f]/95 backdrop-blur-md p-8 transition-opacity duration-300 opacity-0 select-none">
    <!-- Close Button -->
    <button id="lightbox-close" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center bg-[#1a1a24] border border-[#2a2a3f] rounded-full text-[#8a8899] hover:border-[#ff6b9d] hover:text-[#ff6b9d] active:scale-95 transition-all cursor-pointer z-[110]" title="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    
    <!-- Lightbox Content -->
    <div class="relative w-full max-w-3xl max-h-[80vh] flex flex-col items-center justify-center">
      <img id="lightbox-img" class="w-auto h-auto max-w-full max-h-[65vh] object-contain rounded-2xl shadow-[0_25px_50px_-12px_rgba(0,0,0,0.8),_0_0_40px_rgba(255,107,157,0.15)] border border-[#2a2a3f]" src="" alt="Zoomed Journal Page" />
      
      <!-- Caption Box -->
      <div class="mt-6 flex flex-col items-center text-center">
        <div id="lightbox-tag" class="text-xs font-mono uppercase tracking-wide text-[#ff6b9d] mb-1 font-bold">#tag</div>
        <h2 id="lightbox-title" class="font-serif text-2xl italic text-white mb-2">Title</h2>
        <div id="lightbox-meta" class="text-xs font-mono text-[#8a8899]">date · location</div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 text-[#8a8899] text-xs font-sans tracking-[0.2em] uppercase">
    captured journal binder
  </div>

</div>

<script>
  const modal = document.getElementById('lightbox-modal')!;
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const modalTag = document.getElementById('lightbox-tag')!;
  const modalTitle = document.getElementById('lightbox-title')!;
  const modalMeta = document.getElementById('lightbox-meta')!;
  const modalClose = document.getElementById('lightbox-close')!;

  document.querySelectorAll('.journal-card').forEach(card => {
    card.addEventListener('click', () => {
      const el = card as HTMLElement;
      const url = el.dataset.url;
      const title = el.dataset.title;
      const tag = el.dataset.tag;
      const date = el.dataset.date;
      const location = el.dataset.location;

      if (url && modalImg) {
        modalImg.src = url;
        modalTag.textContent = tag || '';
        modalTitle.textContent = title || '';
        modalMeta.textContent = `${date || ''} · ${location || ''}`;
        
        modal.classList.remove('hidden');
        // Force browser layout reflow before opacity triggers
        void modal.offsetWidth;
        
        modal.classList.add('opacity-100');
        modal.classList.remove('opacity-0');
      }
    });
  });

  const closeModal = () => {
    if (modal) {
      modal.classList.add('opacity-0');
      modal.classList.remove('opacity-100');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300); // Match transition length
    }
  };

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #2a2a3f;
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #ff6b9d;
  }
</style>
